%define anolis_release 1
%global debug_package %{nil}

Name:           copilot-shell
Version:        @VERSION@
Release:        %{anolis_release}%{?dist}
Summary:        Copilot Shell - Entrance to AI-native OS
License:        Apache-2.0
URL:            https://github.com/alibaba/anolisa
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  nodejs >= 20
BuildRequires:  make
Requires:       nodejs >= 20
Requires(post):	  lua
Requires(postun): lua
Provides:       %{_bindir}/co %{_bindir}/copilot %{_bindir}/cosh
Provides:       anolisa-component(cosh)
Conflicts:      cosh-ng

%description
Copilot Shell - Entrance to AI-native OS.
AI-powered assistant that helps developers through natural language interaction.

%prep
%setup -q

%build
make deps-ci
make build

%install
rm -rf %{buildroot}
make install DESTDIR=%{buildroot} PREFIX=%{_prefix}
install -d %{buildroot}%{_datadir}/anolisa/components/cosh
install -m 0644 component.toml %{buildroot}%{_datadir}/anolisa/components/cosh/component.toml

# Install cosh-switch script
cat > %{buildroot}%{_bindir}/cosh-switch << 'EOF'
#!/bin/bash
set -e
current=$(rpm -q --qf '%%{NAME}' -f /usr/bin/cosh 2>/dev/null || echo "none")
case "$current" in
  cosh-ng)
    target="copilot-shell"
    echo "Current: cosh-ng -> switching to copilot-shell"
    sudo yum swap cosh-ng copilot-shell ;;
  copilot-shell)
    target="cosh-ng"
    echo "Current: copilot-shell -> switching to cosh-ng"
    sudo yum swap copilot-shell cosh-ng ;;
  *)
    echo "Error: neither cosh-ng nor copilot-shell is installed."; exit 1 ;;
esac
case "${LANG:-}" in
  zh_*|zh)
    echo ""
    echo "已切换到 ${target}。当前会话仍运行在旧模式下，无法热切换。"
    echo "请退出并重新打开 shell（或重新连接会话），再运行 \"cosh\" 进入新模式。" ;;
  *)
    echo ""
    echo "Switched to $target. The current session still runs the old mode and cannot hot-switch."
    echo "Please exit and reopen your shell (or reconnect the session), then run \"cosh\" to enter the new mode." ;;
esac
EOF
chmod 0755 %{buildroot}%{_bindir}/cosh-switch

# Install cosh-switch extension (provides /cosh-switch slash command)
install -d %{buildroot}%{_datadir}/anolisa/extensions/cosh-switch/commands
cat > %{buildroot}%{_datadir}/anolisa/extensions/cosh-switch/cosh-extension.json << 'EOF'
{
  "name": "cosh-switch",
  "version": "1.0.0",
  "commands": ["commands"]
}
EOF
cat > %{buildroot}%{_datadir}/anolisa/extensions/cosh-switch/commands/cosh-switch.toml << 'EOF'
description = "Switch between copilot-shell and cosh-ng"
show_command = false
run = """set -e
current=$(rpm -q --qf '%%{NAME}' -f /usr/bin/cosh 2>/dev/null || echo 'none')
case "$current" in
  cosh-ng)
    target='copilot-shell'
    echo 'Current: cosh-ng -> switching to copilot-shell'
    sudo yum swap cosh-ng copilot-shell ;;
  copilot-shell)
    target='cosh-ng'
    echo 'Current: copilot-shell -> switching to cosh-ng'
    sudo yum swap copilot-shell cosh-ng ;;
  *)
    echo 'Error: neither cosh-ng nor copilot-shell is installed.'; exit 1 ;;
esac
case "${LANG:-}" in
  zh_*|zh)
    echo ''
    echo "已切换到 ${target}。当前会话仍运行在旧模式下，无法热切换。"
    echo '请退出并重新打开 shell（或重新连接会话），再运行 cosh 进入新模式。' ;;
  *)
    echo ''
    echo "Switched to $target. The current session still runs the old mode and cannot hot-switch."
    echo 'Please exit and reopen your shell (or reconnect the session), then run cosh to enter the new mode.' ;;
esac"""
EOF


%files
%license %{_docdir}/%{name}/LICENSE
%doc %{_docdir}/%{name}/README.md
%{_prefix}/lib/%{name}
%{_datadir}/%{name}
%{_datadir}/anolisa/components/cosh/component.toml
%{_bindir}/co
%{_bindir}/copilot
%{_bindir}/cosh
%{_bindir}/cosh-switch
%{_datadir}/anolisa/extensions/cosh-switch

%post -p <lua>
nl        = '\n'
cosh      = '%{_bindir}/cosh'..nl
f = io.open('/etc/shells', 'a+')
if f then
  local shells = nl..f:read('*all')..nl
  if not shells:find(nl..cosh) then f:write(cosh) end
  f:close()
end

%postun -p <lua>
-- Run it only if we are uninstalling. In an rpm lua scriptlet the
-- interpreter token "<lua>" occupies arg[1] and the first scriptlet
-- argument ($1, the count of package instances left after the
-- operation: 0 on final erase, 1 on upgrade) is arg[2]. rpm <= 4.17
-- passes it as a STRING ("0"), while newer rpm prepends
-- "arg[2] = tonumber(arg[2]);" to the scriptlet body, so compare
-- through tonumber() to fire on final erase under both layouts.
local shells = '%{_sysconfdir}/shells'
local cosh = '%{_bindir}/cosh'
if tonumber(arg[2]) == 0
then
  -- Replacement-present protection (mirrors src/cosh-ng/cosh-ng.spec.in):
  -- `yum swap copilot-shell cosh-ng` installs cosh-ng -- which re-owns
  -- /usr/bin/cosh and registers the very same /etc/shells line -- before
  -- this final-erase %postun runs, so dropping the line unconditionally
  -- would delete a login shell that is still valid. Probing the path
  -- directly is fail-safe: querying rpm from inside a scriptlet can fail
  -- under the transaction lock, and an inconclusive probe must keep the
  -- line, never drop it. posix comes from rpm's embedded lua; the io.open
  -- fallback serves standalone interpreters without the extension.
  local function executable(path)
    if posix and posix.access then
      return posix.access(path, 'x') == 0
    end
    local f = io.open(path, 'rb')
    if f then f:close() end
    return f ~= nil
  end
  if executable(cosh) then return end
  -- Atomic rewrite protection (mirrors src/cosh-ng/cosh-ng.spec.in):
  -- filter into a sibling temporary file and rename it over /etc/shells,
  -- so an interrupted or failing write leaves the shared table intact
  -- instead of truncated or partial. Mode and ownership carry over from
  -- the original, an admin-managed symlink is followed so the link
  -- relationship survives, and any failure removes the temporary file
  -- and fails the scriptlet so the transaction surfaces it.
  local function fail(msg)
    io.stderr:write('error: copilot-shell: cannot update '..shells..
                    ': '..msg..'\n')
    error('copilot-shell: '..msg, 0)
  end
  local target = shells
  if posix and posix.readlink then
    for _ = 1, 40 do
      local link = posix.readlink(target)
      if type(link) ~= 'string' then break end
      if link:sub(1, 1) ~= '/' then
        link = (target:match('^(.*/)[^/]+$') or '/')..link
      end
      target = link
    end
  end
  local src = io.open(target, 'rb')
  if not src then return end
  local kept = {}
  for line in src:lines() do
    if line ~= cosh then kept[#kept + 1] = line end
  end
  src:close()
  local pid = '0'
  if posix and posix.getprocessid then
    local info = posix.getprocessid()
    if type(info) == 'table' and info.pid then pid = tostring(info.pid) end
  end
  local tmp = target..'.copilot-shell.'..pid..'.'..tostring(os.time())..'.tmp'
  os.remove(tmp)
  local stale = io.open(tmp, 'rb')
  if stale then
    stale:close()
    fail('temporary file already exists: '..tmp)
  end
  local out = io.open(tmp, 'w')
  if not out then fail('failed to create temporary file') end
  for i = 1, #kept do
    if not out:write(kept[i], '\n') then
      out:close()
      os.remove(tmp)
      fail('failed to filter shell registration')
    end
  end
  if not out:close() then
    os.remove(tmp)
    fail('failed to write temporary file')
  end
  if posix and posix.stat then
    local st = posix.stat(target)
    if st and st.mode and posix.chmod then
      local ok, why = pcall(posix.chmod, tmp, st.mode)
      if not ok or why == nil then
        os.remove(tmp)
        fail('failed to preserve file mode')
      end
    end
    if st and posix.chown then
      local ok, why = pcall(posix.chown, tmp, st.uid, st.gid)
      if not ok or why == nil then
        os.remove(tmp)
        fail('failed to preserve file ownership')
      end
    end
  end
  local ok, why = os.rename(tmp, target)
  if not ok then
    os.remove(tmp)
    fail('failed to replace file: '..tostring(why))
  end
end

