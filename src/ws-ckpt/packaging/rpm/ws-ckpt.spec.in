%define anolis_release 1
%global debug_package %{nil}
# Filter false musl libc deps introduced by vendored node native modules
%global __requires_exclude ^(libc\.musl-x86_64\.so\.1|libc\.so)\(\)\(64bit\)$

Name:           ws-ckpt
Version:        @VERSION@
Release:        %{anolis_release}%{?dist}
Summary:        AI-oriented workspace snapshot tool based on btrfs

License:        Apache-2.0
URL:            https://github.com/alibaba/anolisa
Source0:        %{name}-%{version}.tar.gz
Source1:        %{name}-%{version}-vendor.tar.gz

BuildRequires:  cargo >= 1.70
BuildRequires:  rust >= 1.70
BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  pkgconfig
BuildRequires:  systemd-rpm-macros
BuildRequires:  nodejs >= 18
BuildRequires:  npm

Requires:       %{name}-core = %{version}-%{release}
Requires:       %{name}-plugins = %{version}-%{release}
Requires:       %{name}-skills = %{version}-%{release}
Provides:       anolisa-component(ws-ckpt)

%description
Compatibility package selecting matching ws-ckpt core, plugins, and skills
through exact-version dependencies, without a runtime payload of its own.

%package core
Summary:        Workspace checkpoint CLI and system daemon
Requires:       rsync
Requires:       btrfs-progs
Requires(post): systemd
Requires(preun): systemd
Requires(postun): systemd
Requires(postun): util-linux
Requires:       rpm coreutils grep
Requires(postun): rpm coreutils grep
Conflicts:      %{name} < %{version}
Conflicts:      anolisa < 0.3.21

%description core
ws-ckpt is an AI-oriented filesystem snapshot tool. It supports workspace
initialization, snapshot creation and second-level rollback. Its
multi-backend architecture (btrfs-base / btrfs-loop) with
three-tier auto detection picks the optimal backend for efficient
snapshots.

%package plugins
Summary:        ws-ckpt OpenClaw and Hermes integrations
Requires:       %{name}-core = %{version}-%{release}
Requires:       bash
Requires:       nodejs >= 18
Requires:       python3
Conflicts:      %{name} < %{version}

%description plugins
Host plugin bundles and detection, registration, and removal scripts for
OpenClaw and Hermes. Register integrations as the target Agent user.

%package skills
Summary:        Workspace checkpoint skill
Requires:       %{name}-core = %{version}-%{release}
Conflicts:      %{name} < %{version}

%description skills
Bundled skill documentation and scripts for workspace checkpoint operations.

%prep
%setup -q -a 1

%build
cd src
cargo build --release --offline
cd plugins/openclaw
npm install --ignore-scripts
npm run build

%install
rm -rf $RPM_BUILD_ROOT
install -d -m 0755 %{buildroot}%{_bindir}
install -d -m 0755 %{buildroot}%{_unitdir}
install -d -m 0755 %{buildroot}/etc/ws-ckpt
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/skills/ws-ckpt
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/openclaw
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/hermes
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/openclaw
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/hermes

install -p -m 0755 src/target/release/ws-ckpt %{buildroot}%{_bindir}/ws-ckpt
make install-systemd-unit DESTDIR="%{buildroot}" SYSTEMD_SYSTEM_DIR="%{_unitdir}" SERVICE_BINDIR="%{_bindir}"
install -p -m 0644 src/config.toml.sample %{buildroot}/etc/ws-ckpt/config.toml.sample
# Ship the live config too; %config(noreplace) preserves admin edits on
# upgrade and saves them as .rpmsave on erase (issue #3070).
install -p -m 0644 src/config.toml.sample %{buildroot}/etc/ws-ckpt/config.toml
cp -pr src/skills/ws-ckpt/. %{buildroot}%{_datadir}/anolisa/skills/ws-ckpt/
cp -pr src/plugins/openclaw/dist %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/openclaw/
install -p -m 0644 src/plugins/openclaw/package.json %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/openclaw/
install -p -m 0644 src/plugins/openclaw/openclaw.plugin.json %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/openclaw/
cp -pr src/plugins/hermes/. %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/hermes/
find %{buildroot}%{_datadir}/anolisa/plugins/ws-ckpt/hermes \
    \( -type d -name __pycache__ -o -type d -name tests \
       -o -type f -name '*.pyc' -o -type f -name '.coverage' \) \
    -exec rm -rf {} +
install -p -m 0644 scripts/openclaw/lib-discover.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/openclaw/
install -p -m 0644 scripts/openclaw/lib-openclaw.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/openclaw/
install -p -m 0755 scripts/openclaw/detect-openclaw.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/openclaw/
install -p -m 0755 scripts/openclaw/install-openclaw.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/openclaw/
install -p -m 0755 scripts/openclaw/uninstall-openclaw.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/openclaw/
install -p -m 0644 scripts/hermes/lib-discover.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/hermes/
install -p -m 0755 scripts/hermes/detect-hermes.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/hermes/
install -p -m 0755 scripts/hermes/install-hermes.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/hermes/
install -p -m 0755 scripts/hermes/uninstall-hermes.sh %{buildroot}%{_datadir}/anolisa/adapters/ws-ckpt/hermes/

%files

%files core
%license LICENSE
%doc README.md
%attr(0755,root,root) %{_bindir}/ws-ckpt
%{_unitdir}/ws-ckpt.service
%dir /etc/ws-ckpt
%config(noreplace) /etc/ws-ckpt/config.toml
/etc/ws-ckpt/config.toml.sample

%files skills
%dir %{_datadir}/anolisa/skills
%{_datadir}/anolisa/skills/ws-ckpt/

%files plugins
%dir %{_datadir}/anolisa/plugins
%{_datadir}/anolisa/plugins/ws-ckpt/
%{_datadir}/anolisa/adapters/ws-ckpt/

%post core
systemctl daemon-reload
systemctl enable ws-ckpt.service
systemctl restart ws-ckpt.service 2>/dev/null || true
echo "ws-ckpt installed, started and enabled at boot."
echo "Run 'systemctl status ws-ckpt' to check service status."
echo "Run 'ws-ckpt --help' for usage."

%post plugins
# The first split-package upgrade installs plugins as a new package too.
# This obsolete directory is not part of the current per-framework inventory.
rm -rf %{_datadir}/anolisa/adapters/ws-ckpt/scripts 2>/dev/null || true

# A rollback installs the old service owner before erasing the new core.
# Save policy before the old package enables/restarts the service.
%triggerprein core -- ws-ckpt < 0.6.1
owner=$(rpm -qf %{_unitdir}/ws-ckpt.service --qf '%%{NAME}\n') || exit 1
printf '%s\n' "$owner" | grep -Fxq ws-ckpt-core || exit 0
[ -d /run/systemd/system ] || exit 0
set -eu
state_dir=/run/ws-ckpt-rpm-rollback
if [ -L "$state_dir" ] || { [ -e "$state_dir" ] && { [ ! -d "$state_dir" ] || [ ! -O "$state_dir" ]; }; }; then
    echo 'ERROR: unsafe ws-ckpt RPM rollback state directory' >&2
    exit 1
fi
install -d -m 0700 "$state_dir"
rm -f "$state_dir/state" "$state_dir/state.tmp"
umask 077
enabled=$(systemctl is-enabled ws-ckpt.service) || :
active=$(systemctl is-active ws-ckpt.service) || :
case "$enabled" in
    enabled|enabled-runtime|disabled|masked|masked-runtime) ;;
    *) echo 'ERROR: cannot capture ws-ckpt enablement for rollback' >&2; exit 1 ;;
esac
case "$active" in
    active|reloading|activating|inactive|failed|deactivating) ;;
    *) echo 'ERROR: cannot capture ws-ckpt activity for rollback' >&2; exit 1 ;;
esac
printf '%s\n' "$enabled" "$active" > "$state_dir/state.tmp"
mv -f "$state_dir/state.tmp" "$state_dir/state"

%preun core
if [ $1 -eq 0 ]; then
    # Recover workspaces before stopping the daemon. A sentinel file carries
    # the outcome to %postun: when recover fails (e.g. a detached registration
    # whose snapshots may be the only copy of the data), %postun must NOT wipe
    # /var/lib/ws-ckpt — that would destroy exactly the data recover refused
    # to touch. The sentinel lives in /run (tmpfs) so it never survives a
    # reinstall or leaks into the package's file list.
    rm -f /run/ws-ckpt-recover-failed
    if [ -x %{_bindir}/ws-ckpt ]; then
        if ! %{_bindir}/ws-ckpt recover --all --force; then
            echo "WARNING: ws-ckpt recover --all failed; preserving /var/lib/ws-ckpt"
            echo "         (and /data/ws-ckpt if present) for manual inspection."
            echo "         Reinstall ws-ckpt or inspect the snapshots manually"
            echo "         before deleting the state directories."
            : > /run/ws-ckpt-recover-failed
        fi
    fi
    systemctl stop ws-ckpt.service 2>/dev/null || true
    systemctl disable ws-ckpt.service 2>/dev/null || true
fi

%postun core
if [ $1 -eq 0 ]; then
    # BtrfsLoop backend: umount, detach loop, then wipe state dirs.
    # The daemon may have been serving on either the canonical FHS path or
    # the pre-FHS legacy path (when migration was deferred); clean up both.
    umount /mnt/btrfs-workspace 2>/dev/null || true
    for img in /var/lib/ws-ckpt/btrfs-data.img /data/ws-ckpt/btrfs-data.img; do
        losetup -j "$img" 2>/dev/null | \
            cut -d: -f1 | xargs -r losetup -d 2>/dev/null || true
    done
    rmdir /mnt/btrfs-workspace 2>/dev/null || true
    # Skip the state wipe when %preun's recover failed: the loop image and
    # state directories may hold the only remaining copies of workspace data
    # (issue #3069). Loop devices were already detached above, so the files
    # are merely left on disk for manual recovery.
    if [ -e /run/ws-ckpt-recover-failed ]; then
        echo "NOTE: preserving /var/lib/ws-ckpt (recover failed in %preun)."
        echo "      Remove it manually once the data is no longer needed."
    else
        # Remove daemon runtime state to avoid stale state on reinstall
        rm -rf /var/lib/ws-ckpt /data/ws-ckpt 2>/dev/null || true
    fi
    rm -f /run/ws-ckpt-recover-failed
    systemctl daemon-reload
fi

# Final erase of core can be a handoff to the legacy monolith, not an uninstall.
state_dir=/run/ws-ckpt-rpm-rollback
if [ -f "$state_dir/state" ]; then
    if [ -L "$state_dir" ] || [ ! -O "$state_dir" ] || [ -L "$state_dir/state" ] || [ ! -O "$state_dir/state" ]; then
        echo 'ERROR: unsafe ws-ckpt RPM rollback state' >&2
        exit 1
    fi
    set -eu
    remask_required=0
    runtime=
    cleanup_rollback() {
        if [ "$remask_required" -eq 1 ]; then
            systemctl mask $runtime ws-ckpt.service || echo 'WARNING: ws-ckpt rollback could not restore mask' >&2
        fi
        rm -f "$state_dir/state"
        rmdir "$state_dir"
    }
    trap cleanup_rollback EXIT
    trap 'exit 1' HUP INT TERM
    owner=$(rpm -qf %{_unitdir}/ws-ckpt.service --qf '%%{NAME}\n')
    if ! printf '%s\n' "$owner" | grep -Fxq ws-ckpt; then
        echo 'ERROR: legacy ws-ckpt did not take over; rollback state was not restored' >&2
        exit 1
    fi
    { IFS= read -r enabled; IFS= read -r active; } < "$state_dir/state"
    case "$active" in
        active|reloading|activating) action=start ;;
        inactive|failed|deactivating) action=stop ;;
        *) echo 'ERROR: invalid ws-ckpt rollback activity' >&2; exit 1 ;;
    esac
    case "$enabled" in
        masked|masked-runtime)
            # A unit can be masked while still running. Restore both dimensions.
            remask_required=1
            [ "$enabled" != masked-runtime ] || runtime=--runtime
            if [ "$action" = start ]; then
                systemctl unmask $runtime ws-ckpt.service
            fi
            systemctl "$action" ws-ckpt.service
            systemctl mask $runtime ws-ckpt.service
            remask_required=0
            ;;
        enabled|enabled-runtime|disabled)
            systemctl disable --runtime ws-ckpt.service
            systemctl disable ws-ckpt.service
            case "$enabled" in
                enabled) systemctl enable ws-ckpt.service ;;
                enabled-runtime) systemctl enable --runtime ws-ckpt.service ;;
            esac
            systemctl "$action" ws-ckpt.service
            ;;
        *) echo 'ERROR: invalid ws-ckpt rollback enablement' >&2; exit 1 ;;
    esac
fi

%changelog
* Wed Nov 11 2026 ziqi02 <ziqi02@alibaba-inc.com> - 0.7.1-1
- Documentation: Documented that switching `btrfs-base.btrfs_mount` back to a previous root does not recover pruned snapshot records; subvolumes still on that root are re-adopted as pinned recovered orphans to review with `list --orphans` and delete explicitly
- Documentation: Updated the RPM packaging guide for split-package ownership and `/usr/bin` executables, distinguishing RPM installation from the default `/usr/local/bin` source-install layout
- Fixed OpenClaw cron snapshots to use the installed `ws-ckpt` executable discovered from the plugin's PATH, including RPM's `/usr/bin/ws-ckpt`, instead of hardcoded `/usr/local/bin/ws-ckpt`; launcher symlinks remain stable across upgrades
- Fixed Hermes plugin initialization with non-mapping `plugins.ws-ckpt` sections; invalid sections now fall back to defaults and environment overrides
- Scoped Hermes rollback auto-checkpoint suppression to the originating session; hosts without session identity no longer arm suppression
- Rejected blank or null Hermes rollback `preview` values and non-boolean OpenClaw `preview` values before executing rollback
- Rejected fractional, boolean and string rollback depths in both plugins; positive integer-valued JSON numbers remain accepted
- Removed Hermes `tests/` and `.coverage` from `make install` and `make install-plugins` outputs
- Fixed overlapping writers being reported as quiet when one file closes; required a fresh 200 ms quiet interval after observed activity or watcher re-arming
- Rejected quiet-window observations affected by recursive watcher registration instead of treating delayed file events as silence
- Preserved Hermes checkpoint message truncation markers within the existing 80-character limit

* Fri Nov 06 2026 ziqi02 <ziqi02@alibaba-inc.com> - 0.7.0-1
- Added `limit` and `cursor` pagination to Hermes `ws-ckpt-list`
- Added cached health advisory sampling; `health-check-interval=0` disables periodic diagnostics but retains advisory sampling; warnings are omitted when samples are incomplete or stale
- Added skill-only per-turn snapshots, cron schedules and retention management without host plugins; orchestration is model-driven, not a guaranteed lifecycle hook
- **BREAKING** Changed `make install` to install prebuilt files without building or activation; added selective `install-core`, `install-plugins` and `install-skills` targets
- **BREAKING** Defaulted `make install` to `AWPRJ=anolisa`; use `AWPRJ=` for the independent layout
- Moved RPM executables from `/usr/local/bin` to `/usr/bin`
- Removed ANOLISA discovery contracts from standalone packages; new raw packages require ANOLISA ≥ 0.3.21
- Improved cursor paging performance on long snapshot histories
- Shared one inotify instance across workspaces; exposed missing watcher coverage and queue overflows in ws-ckpt and cosh checkpoint status
- Preserved service enablement and activity when rolling back to the legacy unsplit RPM
- Rejected unsafe snapshot IDs at the legacy IPC boundary
- Detached idle loop associations before remount, with bounded retries for transient device holders
- Enforced a 5 GiB minimum for btrfs-loop `img_size`; invalid configuration now fails startup instead of falling back to defaults; repair legacy values with `ws-ckpt config -g --img-size <GiB>`
- Fixed out-of-range `auto_cleanup_keep` ages stopping periodic cleanup; such retentions now keep all snapshots
- Honored `btrfs-base.btrfs_mount` and reused persisted native storage roots across restarts; mount changes require restart without data migration
- Correctly parsed stringified Hermes rollback `preview`, preventing unintended rollback
- Scoped rollback auto-checkpoint suppression to the target workspace and session
- Bounded Hermes plugin activation and deactivation commands; failures or timeouts no longer block local installation or cleanup
- Persisted Hermes workspace and cron configuration before activation
- Resolved symlinked workspace paths in OpenClaw cwd checks
- Corrected the skill's rollback parent-chain guidance: `-n 1` selects HEAD and `-n 2` its parent; undoing a completed turn selects that turn snapshot's parent
- Corrected ws-ckpt IPC enum indices, payload fields and client-mirror compatibility in the cosh-ng reference; wire encoding is unchanged

* Fri Oct 23 2026 ziqi02 <ziqi02@alibaba-inc.com> - 0.6.0-1
- Added CI prebuilt packages for ws-ckpt
- Added pagination to snapshot listings
- Added reconciliation of interrupted cleanup operations
- Improved startup rollback recovery: restore rollback head, finish interrupted rollbacks, and limit repeated daemon restarts
- Fixed non-termination when the parent chain contains a cycle
- Cleaned up stranded config temp files
- Raised the openclaw CLI capture limit past 1 MiB
- Blocked btrfs creates under storage pressure
- Hardened cron locking: require the lock before writes and keep removal with its owner
- Logged failed recovery index saves
- Reused generated checkpoint identifiers
- Translated confirm prompts to English
- Isolated returned schedule arrays
- Refused line breaks in cron-interpolated values
- Parsed metadata before snapshotting
- Refused cwd-inside workspace updates in both plugins and surfaced init failures
- Hardened diff snapshot handling: isolate temp snapshots, preserve escaped paths, and reject malformed snapshot lists
- Re-armed the write watcher after rollback
- Preserved workspace metadata
- Bounded cleanup counts to the u32 range
- Improved test coverage of the ops-log record writer
- Updated the English ws-ckpt README with restored sections

