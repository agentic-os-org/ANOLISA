{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://anolisa.dev/cosh-ng/e2e-result.schema.json",
  "title":"cosh-ng stage E2E result",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","run_id","profile","started_at","finished_at","artifact","environment","cases","cleanup"],
  "properties":{
    "schema_version":{"const":1},
    "run_id":{"type":"string","minLength":1},
    "profile":{"enum":["local","g2","g3","g4","g5"]},
    "started_at":{"type":"string","format":"date-time"},
    "finished_at":{"type":"string","format":"date-time"},
    "artifact":{"type":"object","additionalProperties":false,"required":["path","sha256","git_sha"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"git_sha":{"type":"string","minLength":1}}},
    "environment":{"type":"object"},
    "cases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","attempts","started_at","finished_at","evidence","reason"],"properties":{"id":{"type":"string","pattern":"^E2E-[0-9]{2}$"},"status":{"enum":["PASS","FAIL","BLOCKED","FLAKY"]},"attempts":{"type":"integer","minimum":0},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"evidence":{"type":"array","items":{"type":"string"}},"reason":{"type":"string"},"metrics":{"type":"object"}}}},
    "cleanup":{"type":"object","additionalProperties":false,"required":["status","actions"],"properties":{"status":{"enum":["PASS","FAIL"]},"actions":{"type":"array","items":{"type":"string"}}}}
  }
}
