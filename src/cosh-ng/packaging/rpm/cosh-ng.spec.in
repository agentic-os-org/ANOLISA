%define anolis_release 1
%global debug_package %{nil}
%bcond_without login_lifecycle
%if ! 0%{?_libexecdir_cosh:1}
%global _libexecdir_cosh %{_libexecdir}/anolisa/cosh-ng
%endif
%{!?_skilldir_cosh:%global _skilldir_cosh %{_datadir}/anolisa/skills}

Name:           cosh-ng
Version:        @VERSION@
Release:        %{anolis_release}%{?dist}
Summary:        Computable Operating System Harness - deterministic Agent-OS interface
License:        Apache-2.0
URL:            https://github.com/alibaba/anolisa
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  rust >= 1.88
BuildRequires:  cargo
BuildRequires:  bash
BuildRequires:  gcc
BuildRequires:  systemd-rpm-macros
Requires(pre):    /usr/bin/stat
Requires(post):   lua
Requires(preun):  (%{_bindir}/systemctl if systemd) /usr/bin/getent /usr/bin/awk
Requires(postun): /usr/bin/awk /usr/bin/cat /usr/bin/cp /usr/bin/dirname /usr/bin/id /usr/bin/mkdir /usr/bin/mktemp /usr/bin/mv /usr/bin/readlink /usr/bin/rm /usr/bin/rmdir /usr/bin/stat
Requires(posttrans): /usr/bin/cat /usr/bin/dirname /usr/bin/id /usr/bin/rm /usr/bin/rmdir /usr/bin/stat
Provides:       %{_bindir}/cosh-cli %{_bindir}/cosh %{_libexecdir_cosh}/cosh-gateway
Provides:       anolisa-component(cosh-ng)
%if %{with login_lifecycle}
Provides:       cosh-login-lifecycle-v1
%endif
Conflicts:      copilot-shell
Conflicts:      anolisa < 0.3.21

%description
Computable Operating System Harness (cosh-ng) - a deterministic Agent-OS interface
providing cross-distro structured system operations with JSON output for AI Agents.

%prep
%setup -q

%build
cargo build --locked --workspace --release

%install
rm -rf %{buildroot}

# Copy the shared core inventory; RPM owns its launcher and rendered unit.
bash packaging/payload.sh binaries target/release "%{buildroot}" "%{_bindir}" "%{_libexecdir_cosh}"
bash packaging/payload.sh resources "%{buildroot}%{_libexecdir_cosh}/resources.conf" system \
    "%{_skilldir_cosh}" "%{_datadir}/anolisa/extensions"

# Install the rendered system-level Gateway template.
install -d %{buildroot}%{_unitdir}
sed 's|{libexecdir}/cosh-ng|%{_libexecdir_cosh}|g' \
    packaging/systemd/cosh-gateway@.service.in \
    > %{buildroot}%{_unitdir}/cosh-gateway@.service
chmod 0644 %{buildroot}%{_unitdir}/cosh-gateway@.service

# /usr/bin/cosh is the compiled entry: a symlink onto cosh-shell, which
# dispatches on argv[0]. A script launcher would lose the login argv[0]
# (binfmt_script) and add an interpreter hop to the execve chain; the
# TUI-vs-passthrough decision lives in cosh-shell's invocation classifier.
ln -s %{_libexecdir_cosh}/cosh-shell %{buildroot}%{_bindir}/cosh

install -d %{buildroot}%{_libexecdir}/cosh
sed 's|/usr/libexec/anolisa/cosh-ng/cosh-shell|%{_libexecdir_cosh}/cosh-shell|g' \
    packaging/login/login-preflight > %{buildroot}%{_libexecdir}/cosh/login-preflight
chmod 0755 %{buildroot}%{_libexecdir}/cosh/login-preflight

install -m 0644 packaging/bash/cosh-integration.bash %{buildroot}%{_libexecdir_cosh}/cosh-integration.bash
install -d %{buildroot}%{_datadir}/cosh
%if %{with login_lifecycle}
install -m 0644 packaging/login/login-capability.json %{buildroot}%{_datadir}/cosh/login-capability.json
%endif

# Install documentation
install -d %{buildroot}%{_docdir}/%{name}
install -m 0644 LICENSE %{buildroot}%{_docdir}/%{name}/LICENSE
install -m 0644 README.md %{buildroot}%{_docdir}/%{name}/README.md

# Install the managed Task checkpoint workflow for the outer COSH Agent.
bash packaging/payload.sh skills . "%{buildroot}%{_skilldir_cosh}"

%files
%license %{_docdir}/%{name}/LICENSE
%doc %{_docdir}/%{name}/README.md
%{_bindir}/cosh-cli
%{_bindir}/cosh
%dir %{_libexecdir}/cosh
%{_libexecdir}/cosh/login-preflight
%dir %{_datadir}/cosh
%if %{with login_lifecycle}
%{_datadir}/cosh/login-capability.json
%endif
%dir %{_libexecdir_cosh}
%{_libexecdir_cosh}/cosh-core
%{_libexecdir_cosh}/cosh-gateway
%{_libexecdir_cosh}/cosh-shell
%{_libexecdir_cosh}/resources.conf
%{_libexecdir_cosh}/cosh-integration.bash
%{_unitdir}/cosh-gateway@.service

%{_skilldir_cosh}/manage-task-checkpoints/

%pre
cosh_login_path_safe() {
  [ ! -L "$1" ] || return 1
  if [ "$2" = d ]; then [ -d "$1" ] || return 1; else [ -f "$1" ] || return 1; fi
  cosh_kind="$2"
  cosh_metadata=$(/usr/bin/stat -c '%u %a %h %s' -- "$1" 2>/dev/null) || return 1
  case "$cosh_metadata" in *[!0-9\ ]*|'') return 1 ;; esac
  set -- $cosh_metadata
  [ "$#" -eq 4 ] && [ "$1" -eq 0 ] || return 1
  [ "$((0$2 & 022))" -eq 0 ] || return 1
  if [ "$cosh_kind" = f ]; then
    [ "$((0$2 & 077))" -eq 0 ] && [ "$3" -eq 1 ] && [ "$4" -le 8192 ] || return 1
  fi
}
cosh_login_state_empty() {
  for cosh_parent in / /var /var/lib /var/lib/cosh /var/lib/cosh/login; do
    [ ! -L "$cosh_parent" ] || return 1
    [ -e "$cosh_parent" ] || return 0
    cosh_login_path_safe "$cosh_parent" d || return 1
  done
  for cosh_entry in /var/lib/cosh/login/* /var/lib/cosh/login/.[!.]* /var/lib/cosh/login/..?*; do
    [ -e "$cosh_entry" ] || [ -L "$cosh_entry" ] || continue
    [ "$cosh_entry" = /var/lib/cosh/login/.lock ] && cosh_login_path_safe "$cosh_entry" f || return 1
  done
}
if [ -x /usr/libexec/cosh/login-preflight ]; then
  /usr/libexec/cosh/login-preflight check-protocol 1 --record-version 1 --entry /usr/bin/cosh || exit 1
elif ! cosh_login_state_empty; then
  echo 'error: cannot replace cosh-ng: login state remains or its path is unsafe; use the controlled lifecycle backend first.' >&2
  exit 1
fi

%preun
if [ "$1" -eq 0 ]; then
  if ! /usr/libexec/cosh/login-preflight check-erase; then
    echo 'error: cannot uninstall cosh-ng: use login-preflight erase after restoring login accounts and resolving record conflicts.' >&2
    exit 1
  fi
  if [ -d /run/systemd/system ] && \
      ! systemctl stop 'cosh-gateway@*.service' 'cosh-gateway-acp@*.service'; then
    echo "error: cannot uninstall cosh-ng: failed to stop running Gateway instances." >&2
    exit 1
  fi
fi
%systemd_preun cosh-gateway@.service

%post -p <lua>
local nl = '\n'
local cosh = '%{_bindir}/cosh'
local f, err = io.open('/etc/shells', 'a+')
if f then
  f:seek('set')
  local shells = f:read('*all') or ''
  local normalized = nl..shells
  if shells ~= '' and shells:sub(-1) ~= nl then normalized = normalized..nl end
  if not normalized:find(nl..cosh..nl, 1, true) then
    local separator = (shells ~= '' and shells:sub(-1) ~= nl) and nl or ''
    local written, write_err = f:write(separator, cosh, nl)
    if not written then
      io.stderr:write('warning: cosh-ng: could not register '..cosh..' in /etc/shells: '..tostring(write_err)..nl)
    end
  end
  local closed, close_err = f:close()
  if not closed then
    io.stderr:write('warning: cosh-ng: could not register '..cosh..' in /etc/shells: '..tostring(close_err)..nl)
  end
else
  io.stderr:write('warning: cosh-ng: could not register '..cosh..' in /etc/shells: '..tostring(err)..nl)
end

%postun
# On final erase (not upgrade), drop cosh's own /etc/shells line -- but only
# when /usr/bin/cosh is gone. If a replacement provider (e.g. copilot-shell)
# still owns an executable there, its registration stays valid, so the line is
# kept. Testing the file directly is fail-safe and avoids running rpm inside a
# scriptlet: a nested query can fail under the transaction lock and would then
# wrongly drop a still-valid line.
#
# The rewrite stages into a private 0700 directory next to the target (same
# filesystem, so mv is an atomic rename; cp --attributes-only keeps mode,
# ownership and xattrs). The stage is registered under rpm's scriptlet state
# directory before it is created and records its owner (boot_id + pid +
# starttime), so a SIGKILL mid-rewrite leaves a residue the next cosh-ng
# transaction can find and remove once that owner has provably exited -- even
# if /etc/shells has been repointed in between. An owner whose liveness cannot
# be verified is kept and reported. A sibling random-name temp file would have
# no provable owner and must not be used.
#
# The rewrite also requires the target's directory chain to be owned by root
# (or the scriptlet's own uid) with no group/other write bit; otherwise root
# could be made to dereference a symlink another user planted there. The cosh
# line then stays registered -- a stale entry is harmless compared to
# clobbering a sudoers.d file.
if [ "$1" -eq 0 ]; then
  # BEGIN cosh-ng shells guard+reclaim (identical in %postun and %posttrans)
  cosh_uid="$(id -u 2>/dev/null)" || cosh_uid=""
  cosh_reg="%{_localstatedir}/lib/rpm-state/cosh-ng"
  # Succeeds when $1 and every ancestor are owned by root or this uid and carry
  # no group/other write bit (OpenSSH StrictModes; under rpm only root
  # qualifies), so no other user can swap entries underneath us.
  cosh_chain_safe() {
    c_path="$1"
    [ -n "$cosh_uid" ] || return 1
    while :; do
      c_meta="$(stat -c '%u %A' -- "$c_path" 2>/dev/null)" || return 1
      case "${c_meta#* }" in ?????w*|????????w*) return 1 ;; esac
      case "${c_meta%% *}" in 0|"$cosh_uid") : ;; *) return 1 ;; esac
      [ "$c_path" = / ] && return 0
      c_path="$(dirname -- "$c_path")"
    done
  }
  # Every stage is registered here before it is created, so a stage stays
  # discoverable even after /etc/shells is repointed or left dangling.
  cosh_registry_ok() {
    [ ! -L "$cosh_reg" ] && [ -d "$cosh_reg" ] \
      && [ "$(stat -c '%u %a' -- "$cosh_reg" 2>/dev/null)" = "$cosh_uid 700" ] \
      && cosh_chain_safe "$cosh_reg"
  }
  # Prints "dead", "alive", or "unknown: <reason>" for a recorded owner.
  # Only a provably exited owner is "dead"; anything that cannot be verified
  # (no /proc, unreadable stat, incomplete record) is "unknown" and kept.
  cosh_owner_state() {
    o_boot="$1"; o_pid="$2"; o_start="$3"
    case "$o_pid" in ''|*[!0-9]*) echo "unknown: owner record has no usable pid"; return 0 ;; esac
    o_cur="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || o_cur=""
    [ -n "$o_cur" ] || { echo "unknown: boot_id is unreadable"; return 0; }
    if [ -n "$o_boot" ] && [ "$o_boot" != "$o_cur" ]; then echo dead; return 0; fi
    [ -e "/proc/$o_pid" ] || { echo dead; return 0; }
    o_stat="$(cat "/proc/$o_pid/stat" 2>/dev/null)" || {
      echo "unknown: /proc/$o_pid/stat is unreadable"; return 0; }
    # starttime is procfs field 22, i.e. $20 once pid and (comm) are stripped
    o_stat="${o_stat##*) }"
    # shellcheck disable=SC2086  # split procfs stat fields on purpose
    set -- $o_stat
    case "$1" in Z|X) echo dead; return 0 ;; esac
    if [ -n "$o_start" ] && [ "$o_start" != "${20}" ]; then echo dead; return 0; fi
    if [ -n "$o_boot" ] && [ -n "$o_start" ]; then echo alive; return 0; fi
    echo "unknown: owner identity is incomplete"
  }
  if cosh_registry_ok; then
    for e in "$cosh_reg"/stage.??????????; do
      [ -L "$e" ] && continue
      [ -f "$e" ] || continue
      s=""
      read -r s < "$e" || :
      if [ -z "$s" ]; then
        # registered, then killed before the stage path was recorded
        rm -f -- "$e"
        continue
      fi
      case "$s" in
        /*/.cosh-ng-shells."${e##*.}") : ;;
        *)
          echo "warning: cosh-ng: kept unrecognised stage registry entry $e." >&2
          continue
          ;;
      esac
      if [ ! -e "$s" ] && [ ! -L "$s" ]; then
        # killed before the stage was created, or it is already gone
        rm -f -- "$e"
        continue
      fi
      if ! cosh_chain_safe "$(dirname -- "$s")"; then
        echo "warning: cosh-ng: kept $s: its directory is not exclusively writable by root or uid $cosh_uid." >&2
        continue
      fi
      [ -L "$s" ] && continue
      [ -d "$s" ] || continue
      [ "$(stat -c '%u %a' -- "$s" 2>/dev/null)" = "$cosh_uid 700" ] || continue
      ok=1
      for f in "$s"/* "$s"/.[!.]* "$s"/..?*; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        case "${f##*/}" in owner|shells) : ;; *) ok=0; break ;; esac
        [ -L "$f" ] && { ok=0; break; }
        [ -f "$f" ] || { ok=0; break; }
        [ "$(stat -c '%h' -- "$f" 2>/dev/null)" = 1 ] || { ok=0; break; }
      done
      [ "$ok" = 1 ] || continue
      if [ -s "$s/owner" ]; then
        read -r magic ver boot_kv pid_kv start_kv rest < "$s/owner" || continue
        [ "$magic $ver" = "cosh-ng-shells-stage v1" ] || continue
        [ -z "$rest" ] || continue
        case "$boot_kv $pid_kv $start_kv" in "boot="*" pid="*" start="*) : ;; *) continue ;; esac
        state="$(cosh_owner_state "${boot_kv#boot=}" "${pid_kv#pid=}" "${start_kv#start=}")"
        case "$state" in
          dead) : ;;
          alive) continue ;;
          *)
            echo "warning: cosh-ng: kept $s (${state#unknown: }); remove it by hand once no cosh-ng transaction is running." >&2
            continue
            ;;
        esac
      elif [ -e "$s/shells" ]; then
        # cosh-ng writes the owner record before any shells content
        continue
      fi
      # An owner-less stage holds no shells payload; a writer still filling it
      # fails closed on its next step, so removing it cannot lose data.
      rm -f -- "$s/owner" "$s/shells"
      rmdir -- "$s" 2>/dev/null || :
      [ -e "$s" ] || rm -f -- "$e"
    done
  fi
  # END cosh-ng shells guard+reclaim
  shells="%{_sysconfdir}/shells"
  if [ ! -x "%{_bindir}/cosh" ] && [ -f "$shells" ]; then
    target="$shells"
    if [ -L "$shells" ]; then
      target="$(readlink -f "$shells")" || target="$shells"
    fi
    dir="$(dirname -- "$target")"
    [ -e "$cosh_reg" ] || [ -L "$cosh_reg" ] || mkdir -m 0700 -- "$cosh_reg" 2>/dev/null || :
    if ! cosh_chain_safe "$dir"; then
      echo "warning: cosh-ng: $dir is not exclusively writable by root or uid $cosh_uid; left %{_bindir}/cosh in $shells." >&2
    elif ! cosh_registry_ok; then
      echo "warning: cosh-ng: cannot use stage registry $cosh_reg; left %{_bindir}/cosh in $shells." >&2
    else
      if ! entry="$(mktemp "$cosh_reg/stage.XXXXXXXXXX")"; then
        echo "error: cosh-ng: cannot update $shells: failed to register staging directory." >&2
        exit 1
      fi
      stage="$dir/.cosh-ng-shells.${entry##*.}"
      # Drop the registration only once the stage itself is gone.
      trap 'rm -f -- "$stage/shells" "$stage/owner"; rmdir -- "$stage" 2>/dev/null; [ -e "$stage" ] || rm -f -- "$entry"' EXIT
      trap 'exit 1' INT TERM HUP
      if ! printf '%s\n' "$stage" > "$entry" || ! mkdir -m 0700 -- "$stage"; then
        echo "error: cosh-ng: cannot update $shells: failed to create staging directory." >&2
        exit 1
      fi
      # An unreadable identity is recorded as empty, which the reclaim treats
      # as unverifiable rather than as an exited owner.
      owner_boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || owner_boot=""
      owner_start=""
      if owner_stat="$(cat "/proc/$$/stat" 2>/dev/null)"; then
        owner_stat="${owner_stat##*) }"
        # shellcheck disable=SC2086  # split procfs stat fields on purpose
        set -- $owner_stat
        owner_start="${20-}"
      fi
      if ! printf 'cosh-ng-shells-stage v1 boot=%s pid=%s start=%s\n' \
          "$owner_boot" "$$" "$owner_start" > "$stage/owner"; then
        echo "error: cosh-ng: cannot update $shells: failed to record staging owner." >&2
        exit 1
      fi
      if ! awk -v cosh="%{_bindir}/cosh" '$0 != cosh' "$target" > "$stage/shells"; then
        echo "error: cosh-ng: cannot update $shells: failed to filter shell registration." >&2
        exit 1
      fi
      if ! cp --attributes-only --preserve=mode,ownership,xattr "$target" "$stage/shells"; then
        echo "error: cosh-ng: cannot update $shells: failed to preserve file metadata." >&2
        exit 1
      fi
      if ! mv -f -- "$stage/shells" "$target"; then
        echo "error: cosh-ng: cannot update $shells: failed to replace file." >&2
        exit 1
      fi
      rm -f -- "$stage/owner"
      rmdir -- "$stage" 2>/dev/null || :
      [ -e "$stage" ] || rm -f -- "$entry"
      trap - EXIT INT TERM HUP
    fi
  fi
  rmdir -- "$cosh_reg" 2>/dev/null || :
fi

%posttrans
# Sweep any dead cosh-ng staging directory a prior aborted %postun left behind
# (e.g. the scriptlet or its parent dnf was SIGKILL'd mid-rewrite). Stages are
# found through the registry, not by scanning the current /etc/shells target,
# so a residue is still reclaimed after the symlink was repointed.
# BEGIN cosh-ng shells guard+reclaim (identical in %postun and %posttrans)
cosh_uid="$(id -u 2>/dev/null)" || cosh_uid=""
cosh_reg="%{_localstatedir}/lib/rpm-state/cosh-ng"
# Succeeds when $1 and every ancestor are owned by root or this uid and carry
# no group/other write bit (OpenSSH StrictModes; under rpm only root
# qualifies), so no other user can swap entries underneath us.
cosh_chain_safe() {
  c_path="$1"
  [ -n "$cosh_uid" ] || return 1
  while :; do
    c_meta="$(stat -c '%u %A' -- "$c_path" 2>/dev/null)" || return 1
    case "${c_meta#* }" in ?????w*|????????w*) return 1 ;; esac
    case "${c_meta%% *}" in 0|"$cosh_uid") : ;; *) return 1 ;; esac
    [ "$c_path" = / ] && return 0
    c_path="$(dirname -- "$c_path")"
  done
}
# Every stage is registered here before it is created, so a stage stays
# discoverable even after /etc/shells is repointed or left dangling.
cosh_registry_ok() {
  [ ! -L "$cosh_reg" ] && [ -d "$cosh_reg" ] \
    && [ "$(stat -c '%u %a' -- "$cosh_reg" 2>/dev/null)" = "$cosh_uid 700" ] \
    && cosh_chain_safe "$cosh_reg"
}
# Prints "dead", "alive", or "unknown: <reason>" for a recorded owner.
# Only a provably exited owner is "dead"; anything that cannot be verified
# (no /proc, unreadable stat, incomplete record) is "unknown" and kept.
cosh_owner_state() {
  o_boot="$1"; o_pid="$2"; o_start="$3"
  case "$o_pid" in ''|*[!0-9]*) echo "unknown: owner record has no usable pid"; return 0 ;; esac
  o_cur="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || o_cur=""
  [ -n "$o_cur" ] || { echo "unknown: boot_id is unreadable"; return 0; }
  if [ -n "$o_boot" ] && [ "$o_boot" != "$o_cur" ]; then echo dead; return 0; fi
  [ -e "/proc/$o_pid" ] || { echo dead; return 0; }
  o_stat="$(cat "/proc/$o_pid/stat" 2>/dev/null)" || {
    echo "unknown: /proc/$o_pid/stat is unreadable"; return 0; }
  # starttime is procfs field 22, i.e. $20 once pid and (comm) are stripped
  o_stat="${o_stat##*) }"
  # shellcheck disable=SC2086  # split procfs stat fields on purpose
  set -- $o_stat
  case "$1" in Z|X) echo dead; return 0 ;; esac
  if [ -n "$o_start" ] && [ "$o_start" != "${20}" ]; then echo dead; return 0; fi
  if [ -n "$o_boot" ] && [ -n "$o_start" ]; then echo alive; return 0; fi
  echo "unknown: owner identity is incomplete"
}
if cosh_registry_ok; then
  for e in "$cosh_reg"/stage.??????????; do
    [ -L "$e" ] && continue
    [ -f "$e" ] || continue
    s=""
    read -r s < "$e" || :
    if [ -z "$s" ]; then
      # registered, then killed before the stage path was recorded
      rm -f -- "$e"
      continue
    fi
    case "$s" in
      /*/.cosh-ng-shells."${e##*.}") : ;;
      *)
        echo "warning: cosh-ng: kept unrecognised stage registry entry $e." >&2
        continue
        ;;
    esac
    if [ ! -e "$s" ] && [ ! -L "$s" ]; then
      # killed before the stage was created, or it is already gone
      rm -f -- "$e"
      continue
    fi
    if ! cosh_chain_safe "$(dirname -- "$s")"; then
      echo "warning: cosh-ng: kept $s: its directory is not exclusively writable by root or uid $cosh_uid." >&2
      continue
    fi
    [ -L "$s" ] && continue
    [ -d "$s" ] || continue
    [ "$(stat -c '%u %a' -- "$s" 2>/dev/null)" = "$cosh_uid 700" ] || continue
    ok=1
    for f in "$s"/* "$s"/.[!.]* "$s"/..?*; do
      [ -e "$f" ] || [ -L "$f" ] || continue
      case "${f##*/}" in owner|shells) : ;; *) ok=0; break ;; esac
      [ -L "$f" ] && { ok=0; break; }
      [ -f "$f" ] || { ok=0; break; }
      [ "$(stat -c '%h' -- "$f" 2>/dev/null)" = 1 ] || { ok=0; break; }
    done
    [ "$ok" = 1 ] || continue
    if [ -s "$s/owner" ]; then
      read -r magic ver boot_kv pid_kv start_kv rest < "$s/owner" || continue
      [ "$magic $ver" = "cosh-ng-shells-stage v1" ] || continue
      [ -z "$rest" ] || continue
      case "$boot_kv $pid_kv $start_kv" in "boot="*" pid="*" start="*) : ;; *) continue ;; esac
      state="$(cosh_owner_state "${boot_kv#boot=}" "${pid_kv#pid=}" "${start_kv#start=}")"
      case "$state" in
        dead) : ;;
        alive) continue ;;
        *)
          echo "warning: cosh-ng: kept $s (${state#unknown: }); remove it by hand once no cosh-ng transaction is running." >&2
          continue
          ;;
      esac
    elif [ -e "$s/shells" ]; then
      # cosh-ng writes the owner record before any shells content
      continue
    fi
    # An owner-less stage holds no shells payload; a writer still filling it
    # fails closed on its next step, so removing it cannot lose data.
    rm -f -- "$s/owner" "$s/shells"
    rmdir -- "$s" 2>/dev/null || :
    [ -e "$s" ] || rm -f -- "$e"
  done
fi
# END cosh-ng shells guard+reclaim
rmdir -- "$cosh_reg" 2>/dev/null || :

%changelog
* Mon Jun 16 2026 Shenglong Zhu <shenglongzhu@linux.alibaba.com> - 0.0.0-1
- Initial RPM package
