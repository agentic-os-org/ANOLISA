
%define anolis_release 1
%global debug_package %{nil}
%bcond_with nightly_online

# Use default zstd compression (level 3) instead of -19 to speed up packaging.
%define _binary_payload w.zstdio
%define _source_payload w.zstdio
%{!?_unitdir:%global _unitdir /usr/lib/systemd/system}

# Preserve original shebang (#!/usr/bin/env bash) for cross-platform compatibility
%undefine __brp_mangle_shebangs

Name:           agent-sec-core
Version:        @VERSION@
Release:        %{anolis_release}%{?dist}
Summary:        Agent Security V2 runtime and sandbox

License:        Apache-2.0
URL:            https://github.com/alibaba/anolisa
Source0:        %{name}-%{version}.tar.gz
%if ! %{with nightly_online}
Source1:        %{name}-%{version}-vendor.tar.gz
%endif

# Source1 supplies every Cargo crate and npm package. gcc links the Rust
# binaries and compiles the C sources of ring and bundled libsqlite3-sys.
BuildRequires:  cargo = 1.93.1
BuildRequires:  rust = 1.93.1
BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  nodejs
BuildRequires:  npm
BuildRequires:  systemd-rpm-macros

%{!?systemd_post:%{error:missing %%systemd_post; install systemd-rpm-macros in the rpmbuild environment}}
%{!?systemd_preun:%{error:missing %%systemd_preun; install systemd-rpm-macros in the rpmbuild environment}}
%{!?systemd_postun_with_restart:%{error:missing %%systemd_postun_with_restart; install systemd-rpm-macros in the rpmbuild environment}}

Requires:       systemd
Conflicts:      anolisa < 0.3.21
Requires:       bubblewrap
Requires(pre):  rpm coreutils grep systemd
Requires(post): systemd
Requires(posttrans): coreutils systemd
Provides:       agent-sec-cli = %{version}-%{release}
# Replace legacy packages from before the split.
Obsoletes:      agent-sec-cli < 1.1.2

%description
Native V2 CLI, daemon, health helper, sandbox, configuration and system service.
Framework integrations and skills are supplied separately by agent-sec-plugins
and agent-sec-skills. ANOLISA discovery metadata belongs to the distribution.

%pre
# A virtual Provides does not preserve the old package's final-erase scriptlets.
# Capture before unpacking; restore in posttrans, after old preun/postun ran.
set -eu
state_dir=/run/agent-sec-core-rpm
unit=agent-sec-core.service
if [ -L "$state_dir" ] || { [ -e "$state_dir" ] && [ ! -d "$state_dir" ]; }; then
    echo "ERROR: unsafe AgentSec RPM migration directory: $state_dir" >&2
    exit 1
fi
if [ -d "$state_dir" ]; then
    [ -O "$state_dir" ] || { echo "ERROR: unowned AgentSec RPM migration directory" >&2; exit 1; }
    chmod 0700 "$state_dir"
    rm -f "$state_dir/state" "$state_dir/state.tmp"
fi
# Check the actual NAME, never --whatprovides (which would match the new core).
installed_names=$(rpm -qa --qf '%%{NAME}\n') || {
    echo 'ERROR: cannot inspect installed RPM identities; refusing to guess' >&2
    exit 1
}
if ! printf '%s\n' "$installed_names" | grep -Fxq agent-sec-cli; then
    rmdir "$state_dir" 2>/dev/null || :
    exit 0
fi
install -d -m 0700 "$state_dir"
umask 077
mode=offline
enabled=unknown
active=unknown
if [ ! -x /usr/bin/systemctl ]; then
    echo 'ERROR: systemctl unavailable; refusing to guess AgentSec service state' >&2
    exit 1
fi
if [ -e /usr/lib/systemd/user/agent-sec-core.service ]; then
    # Preserve the explicit V1 transition, but never infer an offline user state.
    if [ ! -d /run/systemd/system ]; then
        echo 'ERROR: offline AgentSec user-unit migration requires explicit deployment' >&2
        exit 1
    fi
    mode=legacy-user
else
    # is-enabled reads unit-file policy without a live manager. Old final erase
    # can remove those links offline too, so capture them before replacement.
    enabled_status=0
    enabled=$(/usr/bin/systemctl is-enabled "$unit") || enabled_status=$?
    case "$enabled:$enabled_status" in
        enabled:0|enabled-runtime:0|disabled:1|masked:1|masked-runtime:1|static:0|indirect:0) ;;
        *) echo "ERROR: cannot capture AgentSec unit enablement; refusing to guess" >&2; exit 1 ;;
    esac
    if [ -d /run/systemd/system ]; then
        active_status=0
        active=$(/usr/bin/systemctl is-active "$unit") || active_status=$?
        case "$active:$active_status" in
            active:0|reloading:0|activating:3|inactive:3|failed:3|deactivating:3) ;;
            *) echo "ERROR: cannot capture AgentSec unit activity; refusing to guess" >&2; exit 1 ;;
        esac
        mode=system
    fi
fi
printf '%s\n' "$mode" "$enabled" "$active" > "$state_dir/state.tmp"
mv -f "$state_dir/state.tmp" "$state_dir/state"

%post
# Transfers, including offline ones, must not be mistaken for fresh installs.
if [ ! -f /run/agent-sec-core-rpm/state ] && [ -d /run/systemd/system ]; then
    %systemd_post agent-sec-core.service
    if [ "$1" -eq 1 ]; then
        /usr/bin/systemctl enable --now agent-sec-core.service >/dev/null 2>&1 || \
            echo 'WARNING: AgentSec initial service activation failed' >&2
    fi
fi

%posttrans
state_dir=/run/agent-sec-core-rpm
unit=agent-sec-core.service
if [ ! -e "$state_dir/state" ]; then
    exit 0
fi
if [ -L "$state_dir" ] || [ ! -O "$state_dir" ] || [ -L "$state_dir/state" ] || \
   [ ! -f "$state_dir/state" ] || [ ! -O "$state_dir/state" ]; then
    echo 'WARNING: refusing untrusted AgentSec RPM migration state' >&2
    exit 1
fi
# Consume once even if restoration fails; a later upgrade must not replay it.
remask_required=0
runtime=
cleanup_migration() {
    if [ "$remask_required" -eq 1 ]; then
        /usr/bin/systemctl mask $runtime "$unit" || \
            echo 'WARNING: AgentSec migration could not restore the original mask' >&2
    fi
    rm -f "$state_dir/state" "$state_dir/state.tmp"
    rmdir "$state_dir" 2>/dev/null || :
}
trap cleanup_migration EXIT
trap 'echo "WARNING: AgentSec service-state restoration interrupted" >&2; exit 1' HUP INT TERM
if ! { IFS= read -r mode; IFS= read -r enabled; IFS= read -r active; } < "$state_dir/state"; then
    echo 'WARNING: invalid AgentSec RPM migration state' >&2
    exit 1
fi
case "$mode" in
    offline|legacy-user|system) ;;
    *) echo 'WARNING: invalid AgentSec RPM migration mode' >&2; exit 1 ;;
esac
if [ ! -x /usr/bin/systemctl ]; then
    echo 'WARNING: systemctl unavailable; AgentSec service policy was not restored' >&2
    exit 1
fi
if [ "$mode" != offline ]; then
    if [ ! -d /run/systemd/system ]; then
        echo 'WARNING: systemd unavailable; AgentSec service state was not restored' >&2
        exit 1
    fi
    if ! /usr/bin/systemctl daemon-reload; then
        echo 'WARNING: AgentSec daemon-reload failed; service was not started' >&2
        exit 1
    fi
fi
if [ "$mode" = legacy-user ]; then
    /usr/bin/systemctl enable --now "$unit" || {
        echo 'WARNING: legacy AgentSec user-unit migration failed' >&2
        exit 1
    }
    exit 0
fi
case "$enabled" in
    enabled|enabled-runtime|disabled|masked|masked-runtime|static|indirect) ;;
    *) echo 'WARNING: invalid captured AgentSec enablement' >&2; exit 1 ;;
esac
reload=
was_active=unknown
if [ "$mode" = offline ]; then
    # Restore boot policy only, even if a manager appeared during the transaction.
    reload=--no-reload
else
    case "$active" in
        active|reloading|activating) was_active=1 ;;
        inactive|failed|deactivating) was_active=0 ;;
        *) echo 'WARNING: invalid captured AgentSec activity' >&2; exit 1 ;;
    esac
fi
restore_failed=0
case "$enabled" in
    masked|masked-runtime)
        # A masked but running unit needs a temporary unmask to resume running.
        # Re-mask even if unmask/start fails; never enable a masked unit.
        runtime=
        [ "$enabled" != masked-runtime ] || runtime=--runtime
        if [ "$mode" != offline ] && [ "$was_active" -eq 1 ]; then
            remask_required=1
            if /usr/bin/systemctl unmask $runtime "$unit"; then
                /usr/bin/systemctl start "$unit" || restore_failed=1
            else
                restore_failed=1
            fi
        elif [ "$mode" != offline ]; then
            /usr/bin/systemctl stop "$unit" || restore_failed=1
        fi
        if /usr/bin/systemctl mask $reload $runtime "$unit"; then
            remask_required=0
        else
            restore_failed=1
        fi
        ;;
    *)
        case "$enabled" in
            enabled|enabled-runtime|disabled)
                /usr/bin/systemctl disable $reload --runtime "$unit" || restore_failed=1
                /usr/bin/systemctl disable $reload "$unit" || restore_failed=1
                case "$enabled" in
                    enabled) /usr/bin/systemctl enable $reload "$unit" || restore_failed=1 ;;
                    enabled-runtime) /usr/bin/systemctl enable $reload --runtime "$unit" || restore_failed=1 ;;
                esac
                ;;
        esac
        # Do not start after a preceding restoration failure.
        if [ "$restore_failed" -eq 0 ] && [ "$mode" != offline ]; then
            if [ "$was_active" -eq 1 ]; then
                /usr/bin/systemctl start "$unit" || restore_failed=1
            else
                /usr/bin/systemctl stop "$unit" || restore_failed=1
            fi
        fi
        ;;
esac
if [ "$restore_failed" -ne 0 ]; then
    echo 'WARNING: AgentSec service state restoration failed; check the unit manually' >&2
    exit 1
fi

%preun
%systemd_preun agent-sec-core.service

%postun
%systemd_postun_with_restart agent-sec-core.service

%files
%defattr(0644,root,root,0755)
%attr(0755,root,root) /usr/bin/agent-sec-cli
%attr(0755,root,root) /usr/bin/agent-sec-daemon
%attr(0755,root,root) /usr/bin/agent-sec-daemon-health
%attr(0755,root,root) /usr/bin/linux-sandbox
%{_unitdir}/agent-sec-core.service
%dir %{_sysconfdir}/agent-sec
%config(noreplace) %attr(0600,root,root) %{_sysconfdir}/agent-sec/skillsec.json
%license LICENSE

%package -n agent-sec-plugins
Summary:        Agent Security framework plugins and hooks
Requires:       %{name} = %{version}-%{release}
Requires:       python3 >= 3.11
Requires:       python3 < 3.12
Requires:       nodejs >= 18
Requires:       jq
Provides:       agent-sec-cosh-hook = %{version}-%{release}
Obsoletes:      agent-sec-cosh-hook < 1.1.2
Provides:       agent-sec-openclaw-hook = %{version}-%{release}
Obsoletes:      agent-sec-openclaw-hook < 1.1.2
Provides:       agent-sec-hermes-hook = %{version}-%{release}
Obsoletes:      agent-sec-hermes-hook < 1.1.2
Provides:       agent-sec-qwen-code-hook = %{version}-%{release}
Obsoletes:      agent-sec-qwen-code-hook < 1.1.2
Provides:       agent-sec-codex-hook = %{version}-%{release}
Obsoletes:      agent-sec-codex-hook < 1.1.2
Provides:       agent-sec-qoder-hook = %{version}-%{release}
Obsoletes:      agent-sec-qoder-hook < 1.1.2

%description -n agent-sec-plugins
Cosh, OpenClaw, Hermes, Qwen Code, Codex and Qoder integration resources.
Register them separately with the target Agent's user configuration.

%files -n agent-sec-plugins
%defattr(0644,root,root,0755)
%attr(0755,root,root) /usr/share/anolisa/extensions/agent-sec-core/hooks/*.py
/usr/share/anolisa/extensions/agent-sec-core/
%attr(0755,root,root) /opt/agent-sec/openclaw-plugin/scripts/deploy.sh
/opt/agent-sec/openclaw-plugin/
%attr(0755,root,root) /opt/agent-sec/hermes-plugin/scripts/deploy.sh
/opt/agent-sec/hermes-plugin/
%attr(0755,root,root) /opt/agent-sec/qwen-code-extension/scripts/deploy.sh
%attr(0755,root,root) /opt/agent-sec/qwen-code-extension/hooks/observability_hook.py
%attr(0755,root,root) /opt/agent-sec/qwen-code-extension/hooks/pii_checker_hook.py
%attr(0755,root,root) /opt/agent-sec/qwen-code-extension/hooks/skill_ledger_hook.py
/opt/agent-sec/qwen-code-extension/
%attr(0755,root,root) /opt/agent-sec/codex-plugin/install.sh
/opt/agent-sec/codex-plugin/
%attr(0755,root,root) /opt/agent-sec/qoder-plugin/install.sh
/opt/agent-sec/qoder-plugin/
%license LICENSE


%package -n agent-sec-skills
Summary:        Agent security skill definitions
Requires:       %{name} = %{version}-%{release}

%description -n agent-sec-skills
Skill reference files and workflow scripts for Agent security integration.

%files -n agent-sec-skills
%defattr(0644,root,root,0755)
%{_datadir}/anolisa/skills/
%license LICENSE


# =============================================================================
# Build & Install
# =============================================================================
%prep
# Source1 overlays the two Cargo vendor trees and the OpenClaw npm cache at
# their project-relative paths before the offline build starts.
%if %{with nightly_online}
%setup -q
%else
%setup -q -a 1
%endif

%build
%if %{with nightly_online}
make build-all-v2 NPM_INSTALL='npm ci --include=dev --omit=optional --ignore-scripts --no-audit --no-fund'
%else
make build-all-v2-offline
%endif

%install
rm -rf $RPM_BUILD_ROOT
make install-all-for-rpmbuild-v2 DESTDIR=$RPM_BUILD_ROOT

