{
  "binding": {
    "bindingId": "10000000-0000-4000-8000-000000000001",
    "bindingRevision": 7,
    "policy": {
      "policyId": "00000000-0000-4000-8000-000000000002",
      "policyName": "mixed file and network",
      "revision": 1,
      "template": {
        "language": "cedar",
        "content": {
          "schema": {"schemaId": "seccore.system", "revision": 3},
          "text": "@id(\"github\")\n@modify(\"inject_credential\")\n@real_token_file(\"/secure/real\")\n@fake_token_file(\"/secure/fake\")\n@inject_header(\"Authorization\")\n@inject_format(\"auto\")\n@response_rewrite(\"true\")\npermit(principal, action == SecCore::Action::\"network.send\", resource is SecCore::HttpEndpoint)\nwhen { resource.host == \"api.github.com\" && context.input.scheme == \"https\" };\nforbid(principal, action == SecCore::Action::\"file.write\", resource is SecCore::File)\nwhen { resource.path == \"/work/data\" && context.input.operation == SecCore::WriteOperation::\"delete\" };"
        }
      },
      "credentialBindings": [{"ruleId": "github", "pairId": "pair-fixture"}]
    },
    "scope": {
      "scopeId": "20000000-0000-4000-8000-000000000001",
      "selector": {"kind": "process", "match": {"processName": "worker"}},
      "process": {
        "bootId": "11111111-2222-4333-8444-555555555555",
        "pidNamespace": "pid:[42]",
        "pid": 4242,
        "startTime": 987654
      }
    }
  },
  "expectedFormats": {
    "gateway": "agent-sec-gateway-binding/v2",
    "agentsight": "agentsight.actplane.binding.v2"
  },
  "expectedGatewayNetwork": {
    "format": "agent-sec-gateway-plan/v2",
    "scopeId": "20000000-0000-4000-8000-000000000001",
    "policies": [{"id": "00000000-0000-4000-8000-000000000002", "revision": 1}],
    "credentials": ["pair-fixture"],
    "rules": [{
      "source": {"policyId": "00000000-0000-4000-8000-000000000002", "policyRevision": 1, "ruleIndex": 0},
      "match": {
        "scheme": "https",
        "host": "api.github.com",
        "path": null,
        "methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"],
        "credentialId": "pair-fixture"
      },
      "header": "Authorization",
      "format": "auto",
      "responseRewrite": true,
      "because": "Credential use allowed by policy"
    }]
  },
  "expectedFileProtection": {
    "version": 1,
    "topology_mode": "static_at_apply",
    "targets": [{
      "path": "/work/data",
      "kind": "exact_file",
      "protections": {"delete": true, "ordinary_write": false},
      "exclusions": []
    }]
  }
}
