{
  "specVersion": "0.1",
  "description": "GitHub REST API and Smart HTTP credential use",
  "rules": [
    {
      "effect": "allow",
      "category": "network",
      "action": "use_credential",
      "target": {
        "type": "http_request",
        "credentialId": "github",
        "scheme": "https",
        "host": "api.github.com",
        "path": "/**",
        "methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"],
        "responseRewrite": true
      },
      "because": "GitHub REST API with github"
    },
    {
      "effect": "allow",
      "category": "network",
      "action": "use_credential",
      "target": {
        "type": "http_request",
        "credentialId": "github",
        "scheme": "https",
        "host": "github.com",
        "path": "/**/info/refs",
        "methods": ["GET"],
        "responseRewrite": true
      },
      "because": "Git ref discovery with github"
    },
    {
      "effect": "allow",
      "category": "network",
      "action": "use_credential",
      "target": {
        "type": "http_request",
        "credentialId": "github",
        "scheme": "https",
        "host": "github.com",
        "path": "/**/git-upload-pack",
        "methods": ["POST"],
        "responseRewrite": false
      },
      "because": "Git fetch with github"
    },
    {
      "effect": "allow",
      "category": "network",
      "action": "use_credential",
      "target": {
        "type": "http_request",
        "credentialId": "github",
        "scheme": "https",
        "host": "github.com",
        "path": "/**/git-receive-pack",
        "methods": ["POST"],
        "responseRewrite": true
      },
      "because": "Git push with github"
    }
  ]
}
