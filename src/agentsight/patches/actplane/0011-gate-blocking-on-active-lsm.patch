+            cap_pending_fd: duplicate(),
+            cap_task_fd: duplicate(),
+            cap_state_fd: duplicate(),
+            cap_policy_fd: duplicate(),
+            ts_counts_fd: duplicate(),
+            append_lock: Arc::new(Mutex::new(())),
