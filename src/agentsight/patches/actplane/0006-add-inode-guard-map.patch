+
+    /// Remove all entries from the inode guard map.
+    pub fn clear_inode_guards(&self) -> io::Result<()> {
+        let mut guard: HashMap<_, FileId, u32> = pinned_hash_map(&self.paths, "te_inode_guard")?;
+        let keys: Vec<FileId> = guard
