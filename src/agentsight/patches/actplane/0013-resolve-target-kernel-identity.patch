+                {
+                    return Err("invalid path_rename BTF prototype".into());
+                }
+                match (*proto).info & 0xffff {
+                    arity @ (4 | 5) => Ok(arity),
+                    arity => Err(format!("unsupported path_rename BTF arity {arity}")),
+                }
+            })();
+            libbpf_sys::btf__free(btf);
+            result
+        })
+        .as_ref()
+        .copied()
+        .map_err(|message| err(message.clone()))
