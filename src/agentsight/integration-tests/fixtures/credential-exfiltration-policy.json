{
  "policy_id": "credential-exfiltration",
  "revision": 1,
  "source_patterns": [
    "/root/.aws/credentials",
    "/root/.ssh/id_rsa"
  ],
  "trusted_endpoints": [
    "10.0.0.8"
  ],
  "taint_label": "CREDENTIAL",
  "taint_ttl_secs": 900,
  "destination_scope": "public_ipv4",
  "mode": "audit"
}
