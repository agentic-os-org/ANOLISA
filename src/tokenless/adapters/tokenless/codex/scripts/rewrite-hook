#!/usr/bin/env python3
"""Codex PreToolUse command rewriting hook via Protocol v2 PreTool.

Reads a PreToolUse hook request from stdin, asks ``tokenless compress`` for
the PreTool rewrite of the shell command, and returns the rewritten command
via ``updatedInput``. The rewritten command runs through the RTK linked into
the same tokenless executable (``tokenless rtk``).

Protocol:
    stdin  ← codex PreToolUse JSON (tool_name, tool_input.command, ...)
    stdout → {"hookSpecificOutput": {"hookEventName": "PreToolUse",
                                      "permissionDecision": "allow",
                                      "updatedInput": {...}}}

Fail-open: all error paths exit 0 with empty stdout (passthrough).
"""

import json
import os
import shutil
import subprocess
import sys
from typing import NoReturn, Optional, Tuple

try:
    import pwd as _pwd

    _REAL_HOME = _pwd.getpwuid(os.getuid()).pw_dir
except (ImportError, KeyError):
    _REAL_HOME = ""
if not os.path.isabs(_REAL_HOME):
    _REAL_HOME = ""

AGENT_ID = os.environ.get("TOKENLESS_AGENT_ID", "codex")
# Leaves headroom under the 10 second hook timeout in hooks.json.
_PRE_TOOL_TIMEOUT = 8


def _skip() -> NoReturn:
    """Exit silently with empty stdout (codex protocol: empty stdout = passthrough)."""
    sys.exit(0)


def _known_tokenless_paths() -> Tuple[str, ...]:
    """Return standalone fallbacks for the supported installation layouts."""
    # Codex can cache this script without common/hooks. Keep this standalone
    # copy aligned with check-tokenless and hook_utils.py::_known_binary_paths.
    paths = []
    if _REAL_HOME:
        paths.append(os.path.join(_REAL_HOME, ".local", "bin", "tokenless"))
    paths.extend(("/usr/local/bin/tokenless", "/usr/bin/tokenless"))
    if _REAL_HOME:
        paths.extend(
            (
                os.path.join(_REAL_HOME, ".local", "share", "anolisa", "tokenless", "tokenless"),
                os.path.join(_REAL_HOME, ".local", "lib", "anolisa", "tokenless", "tokenless"),
            )
        )
    return tuple(paths)


def _find_tokenless() -> Optional[str]:
    path = shutil.which("tokenless")
    if path:
        return path
    for fp in _known_tokenless_paths():
        if os.path.isfile(fp) and os.access(fp, os.X_OK):
            return fp
    return None


def _pre_tool(tokenless_bin: str, request: dict) -> Optional[dict]:
    """Run one PreTool request; None when Core is unavailable or out of contract."""
    try:
        proc = subprocess.run(
            [tokenless_bin, "compress"],
            input=json.dumps(request, ensure_ascii=False),
            capture_output=True,
            text=True,
            timeout=_PRE_TOOL_TIMEOUT,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    try:
        response = json.loads(proc.stdout)
    except ValueError:
        return None
    # A version-skewed binary may speak another contract; never trust it.
    if (
        not isinstance(response, dict)
        or response.get("protocol_version") != 2
        or response.get("operation") != "pre_tool"
    ):
        return None
    result = response.get("result")
    return result if isinstance(result, dict) else None


def main() -> None:
    tokenless_bin = _find_tokenless()
    if not tokenless_bin:
        _skip()

    try:
        raw = sys.stdin.read()
        if not raw.strip():
            _skip()
        input_data = json.loads(raw)
    except (json.JSONDecodeError, EOFError, ValueError):
        _skip()

    # A payload that parses but is not an object carries no tool_name or
    # tool_input, so there is nothing to rewrite. Take the same silent
    # path as undecodable input rather than raising, as the sibling hooks
    # already do.
    if not isinstance(input_data, dict):
        _skip()

    tool_name = input_data.get("tool_name", "")
    tool_input = input_data.get("tool_input", {})
    if isinstance(tool_input, str):
        try:
            tool_input = json.loads(tool_input)
        except (json.JSONDecodeError, ValueError):
            _skip()
    if not isinstance(tool_input, dict):
        # A JSON-encoded tool_input can decode to a list, number, or plain
        # string. There is no command to rewrite in any of them, so take the
        # silent pass-through path instead of raising AttributeError on
        # .get() — the sibling common/hooks/rewrite_hook.py holds the same
        # guard, and the fail-open contract ("all error paths exit 0 with
        # empty stdout") covers decoded-but-unusable nested shapes too.
        _skip()
    cmd = tool_input.get("command", "")
    if not isinstance(cmd, str) or not cmd:
        _skip()

    attribution = {"agent_id": AGENT_ID}
    for field in ("session_id", "tool_use_id"):
        value = input_data.get(field)
        if isinstance(value, str) and value:
            attribution[field] = value

    result = _pre_tool(
        tokenless_bin,
        {
            "protocol_version": 2,
            "operation": "pre_tool",
            "attribution": attribution,
            "input": {
                "tool_name": tool_name if isinstance(tool_name, str) else "",
                "arguments": tool_input,
                "command_field": "command",
                "capabilities": {"replace_arguments": True, "block_and_suggest": False},
            },
        },
    )
    if (
        result is None
        or result.get("action") != "replace_arguments"
        or result.get("output_optimization") != "rtk"
    ):
        _skip()
    updated_input = result.get("arguments")
    if not isinstance(updated_input, dict):
        _skip()
    rewritten = updated_input.get("command")
    if not isinstance(rewritten, str) or not rewritten or rewritten == cmd:
        _skip()

    response = {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "updatedInput": updated_input,
        }
    }
    print(json.dumps(response, ensure_ascii=False))


if __name__ == "__main__":
    main()
