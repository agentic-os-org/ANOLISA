{
  "name": "@anolisa/dsh-tokenless",
  "version": "@VERSION@",
  "description": "Native DeepSeek Harness lifecycle integration for Tokenless",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
