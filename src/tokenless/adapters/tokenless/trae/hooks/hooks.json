{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "RunCommand",
        "hooks": [
          {
            "type": "command",
            "command": "TOKENLESS_AGENT_ID=trae bash @TOKENLESS_DISPATCHER@ rewrite_hook.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "TOKENLESS_AGENT_ID=trae bash @TOKENLESS_DISPATCHER@ tool_ready_hook.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!(?:Read|Glob|LS)$).+",
        "hooks": [
          {
            "type": "command",
            "command": "TOKENLESS_AGENT_ID=trae bash @TOKENLESS_DISPATCHER@ compress_response_hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
