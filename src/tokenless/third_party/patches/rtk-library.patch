+// Each caller runs in a disposable host process, so signal state is isolated.
+#[allow(unsafe_code)] // libc is required to install and inspect the host's signal handlers.
+fn assert_host_signals_survive(args: &[OsString]) {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static RECEIVED: AtomicUsize = AtomicUsize::new(0);
+    extern "C" fn handle(sig: libc::c_int) {
+        RECEIVED.fetch_or(1 << sig, Ordering::SeqCst);
+    }
+    for sig in [libc::SIGINT, libc::SIGTERM, libc::SIGPIPE] {
+        // SAFETY: handle has the required C ABI and only performs an atomic operation.
+        assert_ne!(
+            unsafe { libc::signal(sig, handle as *const () as libc::sighandler_t) },
+            libc::SIG_ERR
+        );
+    }
+    assert_eq!(rtk::execute(args).unwrap(), 7);
+    assert_eq!(
+        RECEIVED.load(Ordering::SeqCst),
+        (1 << libc::SIGINT) | (1 << libc::SIGTERM)
+    );
+    for sig in [libc::SIGINT, libc::SIGTERM, libc::SIGPIPE] {
+        // SAFETY: sigaction writes an initialized output and the null input leaves it unchanged.
+        let action = unsafe {
+            let mut action = std::mem::MaybeUninit::<libc::sigaction>::uninit();
+            assert_eq!(
+                libc::sigaction(sig, std::ptr::null(), action.as_mut_ptr()),
+                0
+            );
+            action.assume_init()
+        };
+        assert_eq!(
+            action.sa_sigaction,
+            handle as *const () as libc::sighandler_t
+        );
+    }
+    assert_eq!(rtk::execute(&["true".into()]).unwrap(), 0);
+}
+
+#[test]
+fn proxy_preserves_host_signal_handlers() {
+    isolated("proxy_preserves_host_signal_handlers", || {
+        assert_host_signals_survive(&[
+            "proxy".into(),
+            "sh".into(),
+            "-c".into(),
+            "kill -INT \"$PPID\"; kill -TERM \"$PPID\"; exit 7".into(),
+        ]);
+    });
+}
+
+#[test]
+fn streamed_execution_preserves_host_signal_handlers() {
+    isolated("streamed_execution_preserves_host_signal_handlers", || {
+        let bin = std::env::current_dir().unwrap().join("bin");
+        std::fs::create_dir(&bin).unwrap();
+        let cargo = bin.join("cargo");
+        std::fs::write(&cargo, "#!/bin/sh\nkill -INT \"$PPID\"\nkill -TERM \"$PPID\"\nprintf 'error: fixture failure\\n' >&2\nexit 7\n").unwrap();
+        std::fs::set_permissions(&cargo, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let mut paths = vec![bin];
+        paths.extend(std::env::split_paths(&std::env::var_os("PATH").unwrap()));
+        // This process is a private test host; its environment cannot affect other tests.
+        std::env::set_var("PATH", std::env::join_paths(paths).unwrap());
+        assert_host_signals_survive(&["cargo".into(), "build".into()]);
+    });
+}
