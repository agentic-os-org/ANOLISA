+/// Restores separators before passing arguments to command implementations.
+pub(crate) fn restore_arguments(cli: &mut Cli, raw: &[OsString]) {
+    let args = match &mut cli.command {
+        Commands::Git {
+            command:
+                GitCommands::Diff { args } | GitCommands::Log { args } | GitCommands::Checkout { args },
+            ..
+        } => Some(args),
+        Commands::Cargo {
+            command:
+                CargoCommands::Build { args }
+                | CargoCommands::Test { args }
+                | CargoCommands::Clippy { args }
+                | CargoCommands::Check { args }
+                | CargoCommands::Install { args }
+                | CargoCommands::Nextest { args },
+            ..
+        } => Some(args),
+        Commands::Grep {
+            extra_args: args, ..
+        }
+        | Commands::Rg {
+            extra_args: args, ..
+        } => Some(args),
+        _ => None,
+    };
+    if let Some(args) = args {
+        let raw: Vec<String> = raw
+            .iter()
+            .map(|arg| arg.to_string_lossy().into_owned())
+            .collect();
+        *args = core::args_utils::restore_double_dash_with_raw(args, &raw);
+    }
+}
