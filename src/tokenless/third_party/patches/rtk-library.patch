+//! Command rewriting and execution for hosts that own their CLI and process lifecycle.
+
+mod command;
+mod execution;
+mod fallback;
+// These upstream modules also contain standalone CLI features outside this API.
+#[allow(dead_code)]
+mod analytics;
+#[allow(dead_code)]
+mod cmds;
+#[allow(dead_code)]
+mod core;
+#[allow(dead_code)]
+mod discover;
+#[allow(dead_code)]
+mod hooks;
+#[allow(dead_code)]
+mod learn;
+#[allow(dead_code)]
+mod parser;
+
+use clap::{CommandFactory, FromArgMatches};
+use std::ffi::OsString;
+
+pub use hooks::rewrite_cmd::RewriteOutcome;
+
+/// Rewrites text using permissions and configuration without executing a command.
+///
+/// Legacy hook integrity is checked by [`execute`], not this text-only operation.
+/// A rewrite does not authorize execution or bypass the native permission layer.
+pub fn rewrite(command: &str) -> RewriteOutcome {
+    hooks::rewrite_cmd::rewrite(command)
+}
+
+/// Version of the pinned RTK implementation linked into the host.
+pub const VERSION: &str = env!("CARGO_PKG_VERSION");
+
+/// Failures returned without terminating the embedding process.
+#[derive(Debug, thiserror::Error)]
+pub enum RtkError {
+    /// Invalid execution arguments, or a requested help/version response.
+    #[error(transparent)]
+    Arguments(#[from] clap::Error),
+    /// Command execution or integrity verification failed.
+    #[error(transparent)]
+    Execution(#[from] anyhow::Error),
+}
+
+const MANAGEMENT_COMMANDS: &[&str] = &[
+    "init",
+    "hook",
+    "hook-audit",
+    "gain",
+    "cc-economics",
+    "discover",
+    "session",
+    "telemetry",
+    "learn",
+    "config",
+    "trust",
+    "untrust",
+    "verify",
+    "rewrite",
+];
+
+/// Executes command arguments without their program name using the caller's stdio.
+///
+/// The host owns signal handling, deadlines and final process termination. This
+/// entry does not install hooks or start telemetry. Use [`rewrite`] for rewriting.
+///
+/// # Examples
+/// ```
+/// use std::ffi::OsString;
+/// // Help returns to the host without terminating it.
+/// let result = rtk::execute(&[OsString::from("--help")]);
+/// assert!(matches!(result, Err(rtk::RtkError::Arguments(_))));
+/// assert_eq!(rtk::VERSION, "0.49.0");
+/// ```
+///
+/// # Errors
+/// Returns argument errors for unsupported management commands, and execution
+/// errors when integrity checks or command processing fail.
+pub fn execute(args: &[OsString]) -> Result<i32, RtkError> {
+    let raw: Vec<OsString> = std::iter::once(OsString::from("rtk"))
+        .chain(args.iter().cloned())
+        .collect();
+    let mut parser = command::Cli::command().bin_name("tokenless rtk");
+    for name in MANAGEMENT_COMMANDS {
+        parser = parser.mut_subcommand(name, |command| command.hide(true));
+    }
+    let matches = match parser.try_get_matches_from(&raw) {
+        Ok(matches) => matches,
+        Err(error) => {
+            if matches!(
+                error.kind(),
+                clap::error::ErrorKind::DisplayHelp | clap::error::ErrorKind::DisplayVersion
+            ) || args.is_empty()
+                || args.first().is_some_and(|arg| {
+                    arg.to_str().is_some_and(|arg| {
+                        arg.starts_with('-') || core::constants::RTK_META_COMMANDS.contains(&arg)
+                    })
+                })
+            {
+                return Err(error.into());
+            }
+            hooks::integrity::runtime_check()?;
+            return fallback::run(error, args).map_err(Into::into);
+        }
+    };
+    if matches
+        .subcommand_name()
+        .is_some_and(|name| MANAGEMENT_COMMANDS.contains(&name))
+    {
+        return Err(clap::Error::raw(
+            clap::error::ErrorKind::InvalidSubcommand,
+            "this RTK management command is not exposed by Tokenless",
+        )
+        .into());
+    }
+    let mut cli = command::Cli::from_arg_matches(&matches)?;
+    command::restore_arguments(&mut cli, &raw);
+    hooks::integrity::runtime_check()?;
+    execution::run(cli).map_err(Into::into)
+}
+
+const COMMAND_NAME: &str = "tokenless rtk";
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_upstream_command_has_an_explicit_exposure_decision() {
+        let exposed = [
+            "ls",
+            "tree",
+            "read",
+            "smart",
+            "git",
+            "gh",
+            "glab",
+            "aws",
+            "psql",
+            "pnpm",
+            "err",
+            "test",
+            "json",
+            "deps",
+            "env",
+            "find",
+            "diff",
+            "log",
+            "dotnet",
+            "docker",
+            "kubectl",
+            "oc",
+            "summary",
+            "grep",
+            "rg",
+            "wget",
+            "wc",
+            "jest",
+            "vitest",
+            "ctest",
+            "prisma",
+            "tsc",
+            "next",
+            "lint",
+            "prettier",
+            "format",
+            "playwright",
+            "cargo",
+            "npm",
+            "npx",
+            "bun",
+            "bunx",
+            "curl",
+            "run",
+            "proxy",
+            "recall",
+            "pipe",
+            "ruff",
+            "sqlfluff",
+            "pytest",
+            "mypy",
+            "php",
+            "phpunit",
+            "phpstan",
+            "pest",
+            "paratest",
+            "ecs",
+            "pint",
+            "phpt",
+            "rake",
+            "rubocop",
+            "rspec",
+            "pip",
+            "uv",
+            "deno",
+            "go",
+            "sbt",
+            "gt",
+            "golangci-lint",
+            "gradlew",
+            "mvn",
+            "mvnd",
+        ];
+        let parser = command::Cli::command();
+        let actual: std::collections::BTreeSet<_> = parser
+            .get_subcommands()
+            .map(|command| command.get_name())
+            .collect();
+        let expected: std::collections::BTreeSet<_> = exposed
+            .into_iter()
+            .chain(MANAGEMENT_COMMANDS.iter().copied())
+            .collect();
+        assert_eq!(
+            actual, expected,
+            "classify every upstream subcommand before repinning RTK"
+        );
+    }
+
+    #[test]
+    #[cfg(unix)]
+    fn executed_failures_return_without_exiting_the_host() {
+        let _guard = core::utils::TEST_ENV_LOCK.lock().unwrap();
+        assert_eq!(execute(&["false".into()]).unwrap(), 1);
+        assert_eq!(execute(&["true".into()]).unwrap(), 0);
+    }
+
+    #[test]
+    fn management_and_help_return_to_the_host() {
+        for name in MANAGEMENT_COMMANDS {
+            for extra in [None, Some("--invalid")] {
+                let args = std::iter::once(OsString::from(name))
+                    .chain(extra.map(OsString::from))
+                    .collect::<Vec<_>>();
+                assert!(execute(&args).is_err(), "{args:?}");
+            }
+        }
+        let error = execute(&["--help".into()]).unwrap_err();
+        assert!(matches!(error, RtkError::Arguments(ref error)
+            if error.kind() == clap::error::ErrorKind::DisplayHelp));
+    }
+}
