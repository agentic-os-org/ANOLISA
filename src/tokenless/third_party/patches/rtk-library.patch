+/// User configuration that shapes [`rewrite`].
+#[derive(Debug, Clone, Default)]
+pub struct RewriteOptions {
+    /// Commands never rewritten (`[hooks] exclude_commands`).
+    pub excluded: Vec<String>,
+    /// Wrappers kept in front of a rewritten command (`[hooks] transparent_prefixes`).
+    pub transparent_prefixes: Vec<String>,
+}
+
+impl RewriteOptions {
+    /// Reads the current RTK configuration; a missing or invalid file yields defaults.
+    ///
+    /// Unlike the process-wide cache used by the CLI, every call reads the file
+    /// again, so long-lived embedders observe configuration changes.
+    pub fn load() -> Self {
+        let hooks = crate::core::config::Config::load()
+            .unwrap_or_default()
+            .hooks;
+        Self {
+            excluded: hooks.exclude_commands,
+            transparent_prefixes: hooks.transparent_prefixes,
+        }
+    }
+}
+
+/// How a hook should treat one command, matching the `rtk rewrite` exit codes.
 #[derive(Debug, PartialEq)]
-enum RewriteOutcome {
+pub enum RewriteOutcome {
+    /// Exit 0: run the rewritten command; the hook may auto-allow it.
     Allow(String),
+    /// Exit 1: no RTK equivalent; run the command unchanged.
     Passthrough,
+    /// Exit 2: a deny rule matched; defer to the host's native deny.
     Deny,
+    /// Exit 3: run the rewritten command but let the host prompt.
     Ask(String),
 }
 
+/// Decides how a hook should treat `cmd` without printing or exiting.
+///
+/// Records a recall when `cmd` reads one of RTK's tee logs, as `rtk rewrite` does.
+pub fn rewrite(cmd: &str, options: &RewriteOptions) -> RewriteOutcome {
+    let outcome = evaluate(cmd, &options.excluded, &options.transparent_prefixes);
+    if !matches!(outcome, RewriteOutcome::Deny) {
+        track_tee_read(cmd);
+    }
+    outcome
+}
+
 fn evaluate(cmd: &str, excluded: &[String], transparent_prefixes: &[String]) -> RewriteOutcome {
     evaluate_with_verdict(cmd, check_command(cmd), excluded, transparent_prefixes)
 }
