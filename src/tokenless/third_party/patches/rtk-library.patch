+//! Exercise the public library in isolated hosts, independently of Tokenless's CLI.
+
+#![cfg(unix)]
+
+use std::ffi::OsString;
+use std::os::unix::ffi::OsStringExt;
+use std::os::unix::fs::PermissionsExt;
+use std::process::Command;
+
+fn isolated(name: &str, test: impl FnOnce()) {
+    if std::env::var("RTK_LIBRARY_CASE").as_deref() == Ok(name) {
+        test();
+        return;
+    }
+    let root = tempfile::tempdir().unwrap();
+    std::fs::create_dir(root.path().join(".claude")).unwrap();
+    let output = Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", name, "--nocapture"])
+        .current_dir(root.path())
+        .env("RTK_LIBRARY_CASE", name)
+        .env("HOME", root.path())
+        .env("CLAUDE_CONFIG_DIR", root.path().join(".claude"))
+        .env("XDG_CONFIG_HOME", root.path().join("config"))
+        .env("XDG_DATA_HOME", root.path().join("data"))
+        .env("TOKENLESS_DATA_DIR", root.path().join("state"))
+        .env("TOKENLESS_STATS_ENABLED", "0")
+        .env_remove("TOKENLESS_STATS_DB")
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{name}: {output:?}");
+    if name == "recall_survives_legacy_hook_changes" {
+        let stdout = String::from_utf8(output.stdout).unwrap();
+        let (filtered, recovered) = stdout.split_once("RECALL_BEGIN\n").unwrap();
+        assert!(filtered.contains("tokenless rtk recall "), "{filtered}");
+        let (recovered, _) = recovered.split_once("RECALL_END\n").unwrap();
+        assert_eq!(recovered, recovery_output());
+    }
+}
+
+#[test]
+fn rewrite_preserves_permissions_and_native_command_names() {
+    isolated(
+        "rewrite_preserves_permissions_and_native_command_names",
+        || {
+            tamper_legacy_hook();
+            for (rule, expected) in [
+                ("allow", rtk::RewriteOutcome::Allow("rtk git status".into())),
+                ("ask", rtk::RewriteOutcome::Ask("rtk git status".into())),
+                ("deny", rtk::RewriteOutcome::Deny),
+            ] {
+                std::fs::write(
+                    ".claude/settings.json",
+                    serde_json::json!({"permissions":{rule:["Bash(git status)"]}}).to_string(),
+                )
+                .unwrap();
+                assert_eq!(rtk::rewrite("git status"), expected);
+            }
+            std::fs::remove_file(".claude/settings.json").unwrap();
+            assert_eq!(
+                rtk::rewrite("printf hello"),
+                rtk::RewriteOutcome::Passthrough
+            );
+            assert!(matches!(rtk::rewrite("rtk git status"),
+            rtk::RewriteOutcome::Allow(value) | rtk::RewriteOutcome::Ask(value)
+                if value == "rtk git status"));
+        },
+    );
+}
+
+fn tamper_legacy_hook() {
+    std::fs::create_dir_all(".claude/hooks").unwrap();
+    std::fs::write(
+        ".claude/hooks/rtk-rewrite.sh",
+        "#!/bin/sh\n: > hook-executed\n",
+    )
+    .unwrap();
+    std::fs::write(
+        ".claude/hooks/.rtk-hook.sha256",
+        format!("{}  rtk-rewrite.sh\n", "0".repeat(64)),
+    )
+    .unwrap();
+}
+
+#[test]
+fn legacy_hooks_do_not_gate_library_execution() {
+    isolated("legacy_hooks_do_not_gate_library_execution", || {
+        assert!(Command::new("git")
+            .args(["init", "-q"])
+            .status()
+            .unwrap()
+            .success());
+        tamper_legacy_hook();
+        // This parsed command still requires hook integrity in the standalone CLI.
+        assert_eq!(rtk::execute(&["git".into(), "status".into()]).unwrap(), 0);
+        for (args, file, code) in [
+            (
+                vec!["run", "-c", "printf parsed > parsed-result; exit 7"],
+                "parsed-result",
+                7,
+            ),
+            (
+                vec!["sh", "-c", "printf fallback > fallback-result; exit 9"],
+                "fallback-result",
+                9,
+            ),
+        ] {
+            let args = args.into_iter().map(OsString::from).collect::<Vec<_>>();
+            assert_eq!(rtk::execute(&args).unwrap(), code);
+            assert!(std::fs::metadata(file).unwrap().len() > 0);
+        }
+        let standalone = Command::new(env!("CARGO_BIN_EXE_rtk"))
+            .args(["rewrite", "git status"])
+            .output()
+            .unwrap();
+        // Standalone rewriting remains exempt: 0 allows, 3 asks for native permission.
+        assert!(matches!(standalone.status.code(), Some(0 | 3)));
+        let standalone = Command::new(env!("CARGO_BIN_EXE_rtk"))
+            .args(["git", "status"])
+            .output()
+            .unwrap();
+        assert_eq!(standalone.status.code(), Some(1));
+        let stderr = String::from_utf8_lossy(&standalone.stderr);
+        assert!(stderr.contains("hook integrity check FAILED"), "{stderr}");
+        assert!(stderr.contains("rtk init -g --auto-patch"), "{stderr}");
+        assert!(stderr.contains("rtk verify"), "{stderr}");
+        assert!(!std::path::Path::new("hook-executed").exists());
+    });
+}
+
+fn recovery_output() -> String {
+    (0..80)
+        .map(|i| format!("detail {i}: retained original command output\n"))
+        .collect()
+}
+
+#[test]
+fn recall_survives_legacy_hook_changes() {
+    isolated("recall_survives_legacy_hook_changes", || {
+        let database = std::env::current_dir().unwrap().join("recall.db");
+        // This disposable host owns its environment and recovery store.
+        std::env::set_var("RTK_RECALL_DB", &database);
+        std::env::set_var("RTK_RECALL", "1");
+        std::env::set_var("RTK_TEE", "1");
+        std::fs::write("recovery.txt", recovery_output()).unwrap();
+        assert_eq!(
+            rtk::execute(&["err".into(), "cat recovery.txt; exit 7".into()]).unwrap(),
+            7
+        );
+        let connection = rusqlite::Connection::open(&database).unwrap();
+        let hash: String = connection
+            .query_row("SELECT hash FROM recall", [], |row| row.get(0))
+            .unwrap();
+        drop(connection);
+        tamper_legacy_hook();
+        println!("RECALL_BEGIN");
+        assert_eq!(
+            rtk::execute(&["recall".into(), hash.clone().into(), "--full".into()]).unwrap(),
+            0
+        );
+        println!("RECALL_END");
+        let standalone = Command::new(env!("CARGO_BIN_EXE_rtk"))
+            .args(["recall", &hash, "--full"])
+            .output()
+            .unwrap();
+        assert!(standalone.status.success());
+        assert_eq!(standalone.stdout, recovery_output().as_bytes());
+        assert!(!std::path::Path::new("hook-executed").exists());
+        assert_eq!(rtk::execute(&["true".into()]).unwrap(), 0);
+    });
+}
+
+#[test]
+fn management_commands_cannot_enter_native_fallback() {
+    isolated("management_commands_cannot_enter_native_fallback", || {
+        for name in [
+            "init",
+            "hook",
+            "hook-audit",
+            "gain",
+            "cc-economics",
+            "discover",
+            "session",
+            "telemetry",
+            "learn",
+            "config",
+            "trust",
+            "untrust",
+            "verify",
+            "rewrite",
+        ] {
+            let path = std::env::current_dir().unwrap().join(name);
+            std::fs::write(&path, "#!/bin/sh\n: > forbidden-executed\n").unwrap();
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+            // This process is a private test host; its environment cannot affect other tests.
+            std::env::set_var("PATH", std::env::current_dir().unwrap());
+            for args in [
+                vec![name],
+                vec![name, "--invalid"],
+                vec!["--", name],
+                vec!["-v", name, "--invalid"],
+            ] {
+                let args = args.into_iter().map(OsString::from).collect::<Vec<_>>();
+                assert!(rtk::execute(&args).is_err(), "{args:?}");
+                assert!(!std::path::Path::new("forbidden-executed").exists());
+            }
+        }
+    });
+}
+
+#[test]
+fn execute_uses_explicit_arguments_and_returns_to_its_host() {
+    isolated(
+        "execute_uses_explicit_arguments_and_returns_to_its_host",
+        || {
+            for prefix in [vec!["proxy", "sh"], vec!["sh"]] {
+                let mut args = prefix.into_iter().map(OsString::from).collect::<Vec<_>>();
+                args.extend(
+                    [
+                        "-c",
+                        "printf '%s' \"$1\" > 'result file'; exit 7",
+                        "host",
+                        "argument with spaces",
+                    ]
+                    .into_iter()
+                    .map(OsString::from),
+                );
+                assert_eq!(rtk::execute(&args).unwrap(), 7);
+                assert_eq!(
+                    std::fs::read("result file").unwrap(),
+                    b"argument with spaces"
+                );
+            }
+            let args = [
+                "sh".into(),
+                "-c".into(),
+                "printf '%s' \"$1\" > 'result file'".into(),
+                "host".into(),
+                OsString::from_vec(vec![b'a', 0xff]),
+            ];
+            assert_eq!(rtk::execute(&args).unwrap(), 0);
+            assert_eq!(std::fs::read("result file").unwrap(), [b'a', 0xff]);
+            assert_eq!(rtk::execute(&["true".into()]).unwrap(), 0);
+        },
+    );
+}
