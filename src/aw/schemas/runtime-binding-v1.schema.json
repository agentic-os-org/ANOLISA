{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/aw/runtime-binding/v1",
  "title": "Runtime observation binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_id",
    "generation",
    "binding_revision",
    "environment_id",
    "process_ref",
    "observation_source",
    "owner_id",
    "state",
    "sequence"
  ],
  "properties": {
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "process_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "observation_source": {
      "enum": [
        "owned_child",
        "external_attachment"
      ]
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "workspace_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "state": {
      "enum": [
        "running",
        "suspended",
        "exited",
        "detached"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "dependentRequired": {
    "workspace_id": [
      "workspace_generation"
    ],
    "workspace_generation": [
      "workspace_id"
    ]
  }
}
