{
  "valid": [
    {
      "name": "valid_python_builtin",
      "document": {
        "version": "aw-instrumentation-profile/v1alpha1",
        "id": "example.client.python",
        "origin": "builtin",
        "runtime": "python",
        "package": {
          "name": "example-sdk",
          "versions": ">=1.9,<2"
        },
        "targets": [
          {
            "id": "session-call-tool",
            "module": "example_sdk.client.session",
            "qualname": "ClientSession.call_tool",
            "call": "async",
            "hooks": {
              "tool.before": {
                "mode": "control",
                "effects": ["observe", "block", "replace_input"],
                "failure_actions": ["block"]
              },
              "tool.after": {
                "mode": "control",
                "effects": ["observe", "replace_result"],
                "failure_actions": ["withhold_result"]
              }
            },
            "fields": {
              "session_id": { "from": "receiver.session_id", "codec": "text" },
              "tool_name": { "from": "arg.0", "codec": "text" },
              "call_id": { "from": "kwarg.call_id", "codec": "text" },
              "input": { "from": "arg.1.payload.0", "codec": "json" },
              "result": { "from": "result", "codec": "json" }
            }
          }
        ]
      }
    },
    {
      "name": "valid_js_builtin_streaming",
      "document": {
        "version": "aw-instrumentation-profile/v1alpha1",
        "id": "example.agent.js",
        "origin": "builtin",
        "runtime": "js",
        "package": {
          "name": "@example/agent",
          "versions": ">=2.0.0,<3.0.0"
        },
        "targets": [
          {
            "id": "stream-tool-exec",
            "module": "@example/agent/client/session.js",
            "qualname": "AgentClient.streamTool",
            "call": "async_iter",
            "hooks": {
              "tool.before": {
                "mode": "control",
                "effects": ["observe", "block"],
                "failure_actions": []
              },
              "tool.after": {
                "mode": "control",
                "effects": ["observe", "replace_result"],
                "failure_actions": ["withhold_result"]
              }
            },
            "fields": {
              "tool_name": { "from": "arg.0", "codec": "text" },
              "input": { "from": "arg.1", "codec": "json" },
              "result": { "from": "result.chunks.0", "codec": "json" }
            },
            "stream": {
              "buffer": true,
              "max_items": 1024,
              "max_bytes": 1048576
            }
          }
        ]
      }
    },
    {
      "name": "valid_python_custom_fingerprinted",
      "document": {
        "version": "aw-instrumentation-profile/v1alpha1",
        "id": "example.custom.python",
        "origin": "custom",
        "runtime": "python",
        "package": {
          "name": "example_sdk",
          "versions": "==1.12.3.4"
        },
        "targets": [
          {
            "id": "fixed-shell-call",
            "module": "example_sdk.tools.runner",
            "qualname": "Runner.exec_shell",
            "call": "sync",
            "code_sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "hooks": {
              "tool.before": {
                "mode": "control",
                "effects": ["observe", "replace_input"],
                "failure_actions": []
              },
              "permission.request": {
                "mode": "control",
                "effects": ["observe", "ask"],
                "failure_actions": []
              }
            },
            "fields": {
              "tool_name": { "const": "shell" },
              "input": { "from": "arg.0", "codec": "json_string" }
            }
          },
          {
            "id": "prompt-submit",
            "module": "example_sdk.client.prompt",
            "qualname": "submit_prompt",
            "call": "sync_iter",
            "code_sha256": "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
            "hooks": {
              "input.submit": {
                "mode": "observe",
                "effects": ["observe"],
                "failure_actions": []
              },
              "turn.stop": {
                "mode": "observe",
                "effects": ["observe"],
                "failure_actions": []
              }
            },
            "fields": {
              "prompt": { "from": "arg.0", "codec": "text" },
              "output": { "from": "result", "codec": "text" }
            }
          }
        ]
      }
    }
  ],
