{
  "version": "aw-instrumentation-profile/v1alpha1",
  "id": "fixture.js",
  "origin": "builtin",
  "runtime": "js",
  "package": {
    "name": "aw-profile-fixture",
    "versions": "==1.0.0"
  },
  "targets": [
    {
      "id": "call-tool",
      "module": "aw-profile-fixture",
      "qualname": "callTool",
      "call": "sync",
      "hooks": {
        "tool.before": {
          "mode": "control",
          "effects": [
            "observe",
            "block"
          ],
          "failure_actions": [
            "report",
            "block"
          ]
        }
      },
      "fields": {
        "tool_name": {
          "from": "arg.0",
          "codec": "text"
        },
        "input": {
          "from": "arg.1",
          "codec": "json"
        }
      }
    }
  ]
}
