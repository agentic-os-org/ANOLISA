{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/aw/control-grant/v1",
  "title": "Owner-issued runtime control grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "issuer_id",
    "holder_id",
    "runtime_id",
    "runtime_generation",
    "binding_revision",
    "actions",
    "expires_at_ms"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "holder_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^!-~]"
      }
    },
    "runtime_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "stop",
          "resume"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
