{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/aw/audit-export/request/v1alpha1",
  "title": "AW public audit export request v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "operation"
  ],
  "properties": {
    "api_version": {
      "const": "audit-export.aw/v1alpha1"
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cursor",
            "limit"
          ],
          "properties": {
            "type": {
              "const": "enumerate"
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_id",
                    "inventory_digest",
                    "after",
                    "through"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "inventory_digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "after": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "through": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "chain_id",
            "cursor",
            "limit"
          ],
          "properties": {
            "type": {
              "const": "read"
            },
            "chain_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_id",
                    "chain_id",
                    "consumed",
                    "observed_tip"
                  ],
                  "properties": {
                    "source_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "chain_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "consumed": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "sequence",
                        "digest"
                      ],
                      "properties": {
                        "sequence": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4095
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$",
                          "minLength": 64,
                          "maxLength": 64
                        }
                      }
                    },
                    "observed_tip": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "sequence",
                        "digest"
                      ],
                      "properties": {
                        "sequence": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4095
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$",
                          "minLength": 64,
                          "maxLength": 64
                        }
                      }
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        }
      ]
    }
  }
}
