{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/capabilities/context.projection.prepare/input/v1",
  "title": "context.projection.prepare/v1 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "boundary", "constraints"],
  "properties": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "content", "media_type", "origin"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content": {
          "type": "string"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "origin": {
          "enum": [
            "unspecified",
            "command_output",
            "file_content",
            "api_response"
          ]
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        }
      }
    },
    "boundary": {
      "enum": ["before_model", "pre_tool", "post_tool", "proxy"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_text_reencoding"],
      "properties": {
        "allow_text_reencoding": {
          "type": "boolean",
          "description": "When false, the candidate must preserve artifact.media_type; Core rejects a media-type change."
        }
      }
    }
  }
}
