{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/aw/source-capability/v1alpha1",
  "title": "AW Hook Source capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_id",
    "kind",
    "adapter",
    "contract",
    "entrypoint",
    "hooks"
  ],
  "properties": {
    "version": {
      "const": "aw-source-capability/v1alpha1"
    },
    "source_id": {
      "$ref": "#/$defs/identifier"
    },
    "kind": {
      "$ref": "#/$defs/sourceKind"
    },
    "adapter": {
      "$ref": "#/$defs/identifier"
    },
    "contract": {
      "$ref": "#/$defs/profileString"
    },
    "entrypoint": {
      "$ref": "#/$defs/profileString"
    },
    "hooks": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/hookEvent"
      },
      "additionalProperties": {
        "$ref": "#/$defs/hookCapability"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^a-zA-Z0-9._-]"
      }
    },
    "profileString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "not": {
        "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
      }
    },
    "sourceKind": {
      "enum": [
        "native",
        "python",
        "js",
        "sight"
      ]
    },
    "hookEvent": {
      "enum": [
        "session.start",
        "input.submit",
        "tool.before",
        "tool.after",
        "permission.request",
        "compact.before",
        "compact.after",
        "subagent.start",
        "subagent.stop",
        "turn.stop",
        "session.end",
        "model.before_request",
        "runtime.observed",
        "runtime.exited",
        "security.violation",
        "coverage.changed"
      ]
    },
    "hookAuthority": {
      "enum": [
        "control",
        "observe"
      ]
    },
    "hookEffect": {
      "enum": [
        "observe",
        "block",
        "replace_input",
        "replace_result",
        "ask"
      ]
    },
    "failureAction": {
      "enum": [
        "report",
        "block",
        "withhold_result"
      ]
    },
    "hookCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "effects",
        "failure_actions"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/hookAuthority"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hookEffect"
          }
        },
        "failure_actions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/failureAction"
          }
        }
      }
    }
  }
}
