{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/capabilities/security.command.inspect/input/v1",
  "title": "security.command.inspect/v1 input",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "boundary"],
  "properties": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "digest", "language"],
      "properties": {
        "content": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "language": {
          "enum": ["auto", "bash", "python"]
        },
        "tool_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        }
      }
    },
    "boundary": {
      "enum": ["pre_tool"]
    }
  }
}
