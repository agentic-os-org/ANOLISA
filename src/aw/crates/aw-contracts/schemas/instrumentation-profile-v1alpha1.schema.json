  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^a-zA-Z0-9._-]"
      }
    },
    "profileString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "not": {
        "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
      }
    },
    "origin": {
      "enum": [
        "builtin",
        "custom"
      ]
    },
    "runtime": {
      "enum": [
        "python",
        "js"
      ]
    },
    "packageSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "versions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214,
          "not": {
            "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
          }
        },
        "versions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(>=|<=|>|<|==)[0-9]+(\\.[0-9]+){0,3}(,(>=|<=|>|<|==)[0-9]+(\\.[0-9]+){0,3}){0,7}$",
          "not": {
            "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
          }
        }
      }
    },
    "callShape": {
      "enum": [
        "sync",
        "async",
        "sync_iter",
        "async_iter"
      ]
    },
    "codec": {
      "enum": [
        "text",
        "json",
        "json_string"
      ]
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "hookEvent": {
      "enum": [
        "session.start",
        "input.submit",
        "tool.before",
        "tool.after",
        "permission.request",
        "compact.before",
        "compact.after",
        "subagent.start",
        "subagent.stop",
        "turn.stop",
        "session.end",
        "model.before_request",
        "security.violation"
      ]
    },
    "hookAuthority": {
      "enum": [
        "control",
        "observe"
      ]
    },
    "hookEffect": {
      "enum": [
        "observe",
        "block",
        "replace_input",
        "replace_result",
        "ask"
      ]
    },
    "failureAction": {
      "enum": [
        "report",
        "block",
        "withhold_result"
      ]
    },
    "hookCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "effects",
        "failure_actions"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/hookAuthority"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hookEffect"
          }
        },
        "failure_actions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/failureAction"
          }
        }
      }
    },
    "fieldName": {
      "enum": [
        "session_id",
        "turn_id",
        "tool_name",
        "call_id",
        "input",
        "result",
        "prompt",
        "output",
        "request"
      ]
    },
    "fieldFromBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "codec"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
          }
        },
        "codec": {
          "$ref": "#/$defs/codec"
        }
      }
    },
    "fieldConstBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "const"
      ],
      "properties": {
        "const": {
          "$ref": "#/$defs/profileString"
        }
      }
    },
    "fieldBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/fieldFromBinding"
        },
        {
          "$ref": "#/$defs/fieldConstBinding"
        }
      ]
    },
    "streamConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buffer",
        "max_items",
        "max_bytes"
      ],
      "properties": {
        "buffer": {
          "type": "boolean"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "qualname",
        "call",
        "hooks",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
          }
        },
        "qualname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^([A-Za-z][A-Za-z0-9_]*|_|_[A-Za-z0-9][A-Za-z0-9_]*)(\\.([A-Za-z][A-Za-z0-9_]*|_|_[A-Za-z0-9][A-Za-z0-9_]*)){0,3}$",
          "not": {
            "pattern": "[\\r\\n\\u0000\\u2028\\u2029]"
          }
        },
        "call": {
          "$ref": "#/$defs/callShape"
        },
        "hooks": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 13,
          "propertyNames": {
            "$ref": "#/$defs/hookEvent"
          },
          "additionalProperties": {
            "$ref": "#/$defs/hookCapability"
          }
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fieldBinding"
          }
        },
        "code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stream": {
          "$ref": "#/$defs/streamConfig"
        }
      }
    }
  }
}
