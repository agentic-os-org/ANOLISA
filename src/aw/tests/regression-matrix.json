{
  "version": 1,
  "required_targets": [
    "aw-adapter/lib/aw_adapter",
    "aw-cli/lib/aw_cli",
    "aw-cli/test/config_edit_cli",
    "aw-cli/test/packages",
    "aw-cli/test/packages_pty",
    "aw-cli/test/standalone",
    "aw-config/test/configuration",
    "aw-config/test/policy_update",
    "aw-contracts/test/canonical",
    "aw-contracts/test/contracts",
    "aw-contracts/test/orchestration",
    "aw-contracts/test/schemas",
    "aw-core/test/execution",
    "aw-core/test/journal",
    "aw-exec/test/execution",
    "aw-host/test/host",
    "aw-cli/test/installation",
    "aw-package/test/build_cli",
    "aw-provider-sec-core/test/provider",
    "aw-provider-tokenless/test/managed_rtk",
    "aw-provider-tokenless/test/pretool",
    "aw-provider-tokenless/test/provider",
    "aw-provider-tokenless/test/views",
    "aw-provider/test/admission",
    "aw-provider/test/protocol",
    "aw-provider/test/views",
    "aw-service/lib/aw_service",
    "aw-cli/test/agentscope",
    "aw-cli/test/claude_sdk",
    "aw-cli/test/inspect",
    "aw-cli/test/launcher",
    "aw-cli/test/openclaw",
    "aw-cli/test/pi",
    "aw-cli/test/posttool",
    "aw-cli/test/pretool",
    "aw-cli/test/qwenpaw",
    "aw-cli/test/service"
  ],
  "cases": {
    "package-pty-consent": {
      "target": "aw-cli/test/packages_pty",
      "test": "confirmation::tty_acceptance_runs_removal_and_quiet_does_not_bypass_the_prompt"
    },
    "package-pty-refusal": {
      "target": "aw-cli/test/packages_pty",
      "test": "confirmation::tty_refusal_default_and_eof_preserve_every_installed_byte"
    },
    "package-pty-signal": {
      "target": "aw-cli/test/packages_pty",
      "test": "confirmation::prompt_interrupts_retain_signal_exit_codes_without_starting_removal"
    },
    "package-pty-channel": {
      "target": "aw-cli/test/packages_pty",
      "test": "confirmation::mixed_terminal_channels_and_json_never_open_a_confirmation_prompt"
    },
    "package-pty-metadata": {
      "target": "aw-cli/test/packages_pty",
      "test": "confirmation::prompt_metadata_escapes_terminal_and_bidi_control_characters"
    },
    "package-pty-color": {
      "target": "aw-cli/test/packages_pty",
      "test": "terminal::actual_pty_obeys_auto_environment_and_explicit_color_choices"
    },
    "package-pty-output-failure": {
      "target": "aw-cli/test/packages_pty",
      "test": "terminal::output_write_failure_does_not_undo_a_completed_installation"
    },
    "catalog": {
      "target": "aw-adapter/lib/aw_adapter",
      "test": "adapter::catalog::tests::registered_capabilities_match_the_regression_matrix_and_config_schema"
    },
    "security-retry": {
      "target": "aw-cli/test/pretool",
      "test": "retry_neutrality_cannot_undo_security_denials_or_fail_closed_errors"
    },
    "final-replacement": {
      "target": "aw-cli/test/posttool",
      "test": "adapters_keep_observers_and_user_hooks_before_one_final_replacement"
    },
    "qoder-lifecycle": {
      "target": "aw-cli/test/launcher",
      "test": "two_agent_instances_release_independently_and_leave_the_daemon_running"
    },
    "openclaw-lifecycle": {
      "target": "aw-cli/test/openclaw",
      "test": "plugin_callbacks_preserve_configuration_profile_raw_events_and_native_parallelism"
    },
    "hermes-lifecycle": {
      "target": "aw-cli/test/launcher",
      "test": "hermes_probes_and_install_writers_cancel_and_reap_on_signals"
    },
    "qwenpaw-lifecycle": {
      "target": "aw-cli/test/qwenpaw",
      "test": "app_exit_before_readiness_releases_instance_and_owned_files"
    },
    "pi-lifecycle": {
      "target": "aw-cli/test/pi",
      "test": "foreground_factory_installs_both_hooks_and_releases_binding"
    },
    "claude-sdk-lifecycle": {
      "target": "aw-cli/test/claude_sdk",
      "test": "claude_hook_cli_preserves_deny_success_failure_identity_and_audit"
    },
    "agentscope-lifecycle": {
      "target": "aw-cli/test/agentscope",
      "test": "no_factory_attachment_never_reports_ready_and_releases_binding_files"
    },
    "security-block": {
      "target": "aw-provider-sec-core/test/provider",
      "test": "risk_is_a_successful_block_only_with_explicit_mode_and_admission"
    },
    "security-error": {
      "target": "aw-provider-sec-core/test/provider",
      "test": "failed_or_invalid_scans_never_become_policy_blocks"
    },
    "security-cancel": {
      "target": "aw-provider-sec-core/test/provider",
      "test": "host_cancellation_stops_the_nested_scan_cli"
    },
    "security-observe": {
      "target": "aw-provider-sec-core/test/provider",
      "test": "offline_methods_and_after_observation_do_not_need_the_daemon"
    },
    "security-budget": {
      "target": "aw-provider-sec-core/test/provider",
      "test": "stalled_cli_respects_invocation_budget_and_reports_failure"
    },
    "compression-bound": {
      "target": "aw-provider-tokenless/test/provider",
      "test": "applied_cli_result_is_a_bound_text_replacement"
    },
    "compression-failure": {
      "target": "aw-provider-tokenless/test/provider",
      "test": "cli_failures_and_wrong_identity_remain_visible_errors"
    },
    "compression-unsupported": {
      "target": "aw-provider-tokenless/test/provider",
      "test": "unsupported_slots_and_failed_tools_never_call_cli"
    },
    "compression-neutral": {
      "target": "aw-provider-tokenless/test/provider",
      "test": "dry_run_and_no_savings_keep_original_result"
    },
    "retry-ownership": {
      "target": "aw-provider-tokenless/test/pretool",
      "test": "adapters_block_original_and_carry_retry_ownership_into_after"
    },
    "retry-no-mutation": {
      "target": "aw-provider-tokenless/test/pretool",
      "test": "pretool_rejects_direct_mutations_and_keeps_execution_errors_visible"
    },
    "rtk-isolation": {
      "target": "aw-provider-tokenless/test/managed_rtk",
      "test": "managed_path_is_child_only_and_rejects_missing_corrupt_or_unusable_payloads"
    },
    "view-isolation": {
      "target": "aw-provider-tokenless/test/views",
      "test": "description_and_missing_store_never_invoke_or_initialize_component"
    },
    "cancel-initialization": {
      "target": "aw-service/lib/aw_service",
      "test": "audit::tests::cancellation_fences_hook_opens_blocked_in_initial_audit_claim"
    },
    "policy_update_boundary": {
      "target": "aw-config/test/policy_update",
      "test": "launch_and_service_edits_are_rejected_without_values"
    },
    "policy_update_offline_cli": {
      "target": "aw-cli/test/launcher",
      "test": "policy_update::policy_scope_validation_does_not_launch_agents_or_providers_or_modify_files"
    },
    "runtime-reload": {
      "target": "aw-cli/test/launcher",
      "test": "runtime_policy::prewarmed_qoder_and_qwenpaw_switch_before_dispatch_without_restarting"
    },
    "reload-busy": {
      "target": "aw-cli/test/service",
      "test": "policy::whole_request_and_unfinished_tools_return_busy_without_deferred_activation"
    },
    "reload-race": {
      "target": "aw-cli/test/service",
      "test": "policy::request_arriving_during_preparation_wins_and_parallel_update_is_busy"
    },
    "reload-rollback": {
      "target": "aw-cli/test/service",
      "test": "policy::failed_preparation_conflict_and_frozen_edits_preserve_policy_and_context"
    },
    "reload-cancel": {
      "target": "aw-cli/test/service",
      "test": "policy::disconnected_update_cancels_preparation_without_later_activation"
    }
  },
  "agents": {
