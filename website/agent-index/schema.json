{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/agents/repo-index.schema.json",
  "title": "ANOLISA repository index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "repository",
    "default_branch",
    "source_commit",
    "license",
    "install",
    "setup_workflow",
    "documentation",
    "components",
    "platform_support"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"const": "ANOLISA"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "repository": {"type": "string", "pattern": "^https://"},
    "default_branch": {"const": "main"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": "string", "minLength": 1},
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "verify", "components"],
      "properties": {
        "cli": {"type": "string", "minLength": 1},
        "verify": {"type": "string", "minLength": 1},
        "components": {"type": "string", "minLength": 1}
      }
    },
    "setup_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_operating_systems",
        "host_detection",
        "host_aliases",
        "selection_rule",
        "confirmation_rule"
      ],
      "properties": {
        "supported_operating_systems": {
          "type": "array",
          "const": ["linux", "macos"]
        },
        "host_detection": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "host_aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architectures"],
          "properties": {
            "os": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1}
            },
            "architectures": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          }
        },
        "selection_rule": {"type": "string", "minLength": 1},
        "confirmation_rule": {"type": "string", "minLength": 1}
      }
    },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "url"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "version_source", "description", "source_path", "documentation_path", "install", "install_method", "install_variants", "technology", "platform_support"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "version_source": {"const": "source"},
          "description": {
            "type": "string",
            "minLength": 1,
            "not": {"pattern": "^\\s*#"}
          },
          "source_path": {"type": "string", "pattern": "^(src|distribution|deprecated)/[a-z0-9][a-z0-9-]*$"},
          "documentation_path": {"type": "string", "pattern": "^https://"},
          "install": {"type": "string", "minLength": 1},
          "install_method": {"enum": ["bootstrap", "cli", "npm", "manual"]},
          "install_variants": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/installVariant"}
          },
          "technology": {"type": "string", "minLength": 1},
          "platform_support": {"$ref": "#/$defs/platform"}
        }
      }
    },
    "platform_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "linux", "macos", "windows"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "linux": {"type": "array", "items": {"type": "string"}},
        "macos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "support"],
            "properties": {
              "id": {"type": "string"},
              "support": {"oneOf": [{"type": "boolean"}, {"type": "string"}]}
            }
          }
        },
        "windows": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "installTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architectures"],
      "properties": {
        "os": {"enum": ["linux", "macos"]},
        "architectures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "installVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "preferred",
        "platforms",
        "requires",
        "preflight",
        "verify"
      ],
      "properties": {
        "method": {"enum": ["bootstrap", "cli", "npm", "manual"]},
        "preferred": {"type": "boolean"},
        "command": {"type": "string", "minLength": 1},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/installTarget"}
        },
        "requires": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "preflight": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "verify": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "method": {"enum": ["bootstrap", "cli", "npm"]}
          },
          "required": ["command"],
          "not": {"required": ["documentation_url"]}
        },
        {
          "properties": {
            "method": {"const": "manual"}
          },
          "required": ["documentation_url"],
          "not": {"required": ["command"]}
        }
      ]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "macos", "windows", "architectures"],
      "properties": {
        "linux": {"type": "boolean"},
        "macos": {"oneOf": [{"type": "boolean"}, {"const": "aarch64"}]},
        "windows": {"type": "boolean"},
        "architectures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
